{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hunterflowx/schemas/event.schema.json",
  "title": "Hunterflowx Event",
  "type": "object",
  "required": ["id", "ts", "engagement_id", "actor", "type"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt-[A-Za-z0-9._-]+$"
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "engagement_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "scope_loaded",
        "asset_added",
        "role_added",
        "rate_limit_loaded",
        "endpoint_discovered",
        "param_discovered",
        "endpoint_seen_runtime",
        "endpoint_verified_reachable",
        "endpoint_role_inferred",
        "source_file_queued",
        "source_file_read",
        "source_flow_linked",
        "attack_surface_mapped",
        "endpoint_angle_planned",
        "endpoint_angle_tested",
        "creative_hypothesis_added",
        "creative_pivot_added",
        "chain_candidate_added",
        "route_source_parsed",
        "js_endpoint_extracted",
        "openapi_endpoint_imported",
        "graphql_operation_imported",
        "mapping_gap_found",
        "source_runtime_diff_added",
        "loop_started",
        "loop_iteration_started",
        "analysis_completed",
        "attack_path_expanded",
        "fingerprint_added",
        "strategy_adjusted",
        "dead_end_recorded",
        "pivot_decision",
        "retest_scheduled",
        "loop_closed",
        "test_planned",
        "test_started",
        "payload_attempted",
        "control_request_sent",
        "evidence_added",
        "gap_found",
        "verdict_set",
        "finding_promoted",
        "finding_demoted",
        "coverage_reviewed",
        "evidence_reviewed",
        "evidence_judged",
        "judge_reviewed",
        "source_completeness_reviewed",
        "endpoint_prioritized",
        "risk_prioritization_reviewed",
        "domain_profile_loaded",
        "domain_check_planned",
        "domain_check_completed",
        "domain_depth_reviewed",
        "ai_governance_reviewed",
        "agent_role_reviewed",
        "autonomy_boundary_set",
        "data_governance_reviewed",
        "sanitized_export_created",
        "attack_path_reviewed",
        "run_queue_task_added",
        "run_queue_task_approved",
        "run_queue_task_started",
        "run_queue_task_finished",
        "run_queue_task_blocked",
        "proxy_history_imported",
        "fresh_repro_completed",
        "report_status_updated",
        "neo4j_action_requested",
        "operator_note_added",
        "report_draft_created",
        "report_ready"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "not_tested",
        "mapped_only",
        "test_attempted",
        "inconclusive",
        "tested_secure",
        "finding_candidate",
        "confirmed",
        "verified_reachable",
        "mapped_runtime",
        "mapped_static",
        "mapped_js",
        "saved",
        "evidence_sufficient",
        "evidence_partial",
        "evidence_incomplete",
        "judge_reportable",
        "judge_candidate",
        "judge_needs_evidence",
        "judge_blocked",
        "judge_rejected",
        "source_complete",
        "source_partial",
        "source_incomplete",
        "priority_critical",
        "priority_high",
        "priority_medium",
        "priority_low",
        "domain_planned",
        "domain_complete",
        "domain_partial",
        "domain_incomplete",
        "queued",
        "ready",
        "needs_attention",
        "reviewed",
        "created",
        "running",
        "done",
        "failed",
        "draft_ready",
        "draft_blocked",
        "submit_blocked",
        "submitted",
        "triaged",
        "accepted",
        "closed",
        "out_of_scope",
        "by_design",
        "blocked"
      ]
    },
    "method": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "TRACE", "CONNECT"]
    },
    "pivot_type": {
      "type": "string",
      "enum": [
        "endpoint_pivot",
        "js_pivot",
        "role_pivot",
        "fingerprint_pivot",
        "param_pivot",
        "state_pivot",
        "impact_pivot",
        "scope_pivot"
      ]
    },
    "current_phase": {
      "type": "string",
      "enum": ["recon", "analyze", "expand", "retest"]
    },
    "loop_state": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "waiting_for_evidence",
        "waiting_for_role",
        "pivoting",
        "retesting",
        "closed_tested_secure",
        "closed_confirmed",
        "blocked"
      ]
    }
  }
}
