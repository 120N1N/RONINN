        <mxCell id="anti_band" value="&lt;b&gt;ANTI-PATTERNS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="560" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a_0" value="&lt;b&gt;Tool soup&lt;/b&gt;&lt;br&gt;Running every tool on every target without prioritization" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="630" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="a_1" value="&lt;b&gt;AI autopwn&lt;/b&gt;&lt;br&gt;Letting AI execute active payloads without policy gate" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="775" y="630" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="a_2" value="&lt;b&gt;Scanner truth&lt;/b&gt;&lt;br&gt;Submitting raw scanner output as proof (no manual verify)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1420" y="630" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="a_3" value="&lt;b&gt;No canonical store&lt;/b&gt;&lt;br&gt;Disconnected files without dedup or audit trail" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2065" y="630" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="a_4" value="&lt;b&gt;No redaction&lt;/b&gt;&lt;br&gt;Raw tokens, cookies, PII in AI prompts or reports" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
