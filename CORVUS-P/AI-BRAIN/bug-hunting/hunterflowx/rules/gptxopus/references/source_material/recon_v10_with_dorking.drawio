        </mxCell>
        <mxCell id="q3" value="&lt;b&gt;Policy Gate&lt;/b&gt;&lt;br&gt;scope · mode · rate · CAPTCHA · forbidden" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
