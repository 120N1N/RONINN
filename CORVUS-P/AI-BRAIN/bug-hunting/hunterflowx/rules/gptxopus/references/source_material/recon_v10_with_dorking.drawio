        <mxCell id="mod" value="&lt;b&gt;Tools / Modules (concrete CLI)&lt;/b&gt;&lt;br&gt;httpx -path-list api_paths.txt -mc 200 -json   # /openapi.json /swagger.json /v3/api-docs /actuator&lt;br&gt;kr scan live.txt -A=apiroutes-240528 -j -o kiterunner.json&lt;br&gt;graphw00f -t $URL -o graphql.json&lt;br&gt;clairvoyance -o schema.json $URL/graphql&lt;br&gt;grpcurl -plaintext $HOST:443 list&lt;br&gt;jwt_tool $TOKEN  # alg=none, weak HS256, kid injection&lt;br&gt;nuclei -l live.txt -t cors/ -t headers/ -j&lt;br&gt;# Account Recovery: trace /forgot, /reset, /change-email, /2fa-recovery, /magic-link&lt;br&gt;# Username enumeration: response diff on /login vs /forgot vs /register&lt;br&gt;# Token entropy: trigger reset 10× · analyze entropy/lifetime/reuse" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
