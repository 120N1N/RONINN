        <mxCell id="obj_band" value="&lt;b&gt;OBJECTIVE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="130" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="obj" value="&lt;b&gt;Objective&lt;/b&gt;&lt;br&gt;Avoid checklist blindness. AI should not only summarize positive hits; it should also analyze what was not found, which assumptions may be wrong, where coverage is thin, and which next safe test would increase confidence." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="190" width="3160" height="135" as="geometry" />
        </mxCell>
        <mxCell id="challenge_band" value="&lt;b&gt;AI CHALLENGE / DEVIL’S ADVOCATE MODE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="370" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c0" value="&lt;b&gt;Scope assumption check&lt;/b&gt;&lt;br&gt;Are assets excluded, wildcarded, parked, CDN-protected, or wrongly normalized?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="140" y="450" width="1010" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c1" value="&lt;b&gt;Tool coverage challenge&lt;/b&gt;&lt;br&gt;Did crawler/content discovery miss auth-only routes, SPA routes, sourcemaps, API versions, mobile endpoints?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1220" y="450" width="1010" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;b&gt;Auth coverage challenge&lt;/b&gt;&lt;br&gt;Were all roles compared? Were invited, suspended, trial, unpaid, admin, owner, and read-only states covered?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2300" y="450" width="1010" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="&lt;b&gt;Tenant/object challenge&lt;/b&gt;&lt;br&gt;Did we test object boundaries for orgId, teamId, accountId, invoiceId, projectId, exportId?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="140" y="650" width="1010" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;b&gt;Evidence quality challenge&lt;/b&gt;&lt;br&gt;Is the signal from one tool only? Is custom 404 filtered? Are screenshots/request refs linked?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1220" y="650" width="1010" height="150" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="&lt;b&gt;Impact challenge&lt;/b&gt;&lt;br&gt;Is there a credible impact path, or is it merely noisy exposure/misconfig without bounty value?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2300" y="650" width="1010" height="150" as="geometry" />
        </mxCell>
        <mxCell id="negative_band" value="&lt;b&gt;NEGATIVE RESULT REASONING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="900" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n0" value="&lt;b&gt;Ferox/ffuf found little&lt;/b&gt;&lt;br&gt;Maybe target is SPA, paths require auth, custom 404 is wrong, wordlist is not tech-aware, or rate/challenge throttled crawler." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="140" y="980" width="1010" height="165" as="geometry" />
