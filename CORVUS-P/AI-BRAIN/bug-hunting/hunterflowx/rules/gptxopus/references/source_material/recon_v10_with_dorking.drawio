        <mxCell id="v_0" value="&lt;b&gt;V1: Diff accuracy&lt;/b&gt;&lt;br&gt;False-positive diffs filtered (DNS rotation, etc.)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
