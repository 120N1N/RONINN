          </mxGeometry>
        </mxCell>
        <mxCell id="note" value="&lt;b&gt;Implementation note&lt;/b&gt;&lt;br&gt;Make this a service-level contract: AI workers can create proposals, not execute commands. Tool workers accept only signed/approved tool_run_request objects from the policy service." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="2250" width="3160" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
