          <mxGeometry x="2290" y="1040" width="1020" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v_3" value="&lt;b&gt;V4: Regression test&lt;/b&gt;&lt;br&gt;Past findings re-tested · alert if still vulnerable" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
