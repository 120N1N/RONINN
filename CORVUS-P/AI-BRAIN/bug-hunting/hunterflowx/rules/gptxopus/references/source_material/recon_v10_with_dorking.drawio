          <mxGeometry x="100" y="330" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="inp" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;program_id (HackerOne or Bugcrowd handle)&lt;br&gt;API keys ($H1_API · $BC_API)&lt;br&gt;run_mode (passive/active/auth)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#E5E7EB;strokeColor=#374151;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="1020" height="320" as="geometry" />
        </mxCell>
        <mxCell id="mod" value="&lt;b&gt;Tools / Modules (concrete CLI)&lt;/b&gt;&lt;br&gt;curl -u $H1_KEY hackerone.com/api/v1/programs/$ID/structured_scopes&lt;br&gt;curl bugcrowd.com/$program/target_groups.json&lt;br&gt;jq parse → wildcard regex generator&lt;br&gt;bounty tier extractor (severity → $)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#E5E7EB;strokeColor=#374151;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1160" y="400" width="1020" height="320" as="geometry" />
        </mxCell>
        <mxCell id="outs" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;scope_in.txt   (regex: ^.*\.target\.com$)&lt;br&gt;scope_out.txt  (forbidden hosts)&lt;br&gt;bounty_tiers.json  (severity → bounty)&lt;br&gt;forbidden_actions.json (no DoS, no SE, no auto-scan)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#E5E7EB;strokeColor=#374151;strokeWidth=1.5;" vertex="1" parent="1">
