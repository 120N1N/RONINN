        </mxCell>
        <mxCell id="obj" value="&lt;b&gt;Objective&lt;/b&gt;&lt;br&gt;Make CAPTCHA, Turnstile, bot walls, access challenges, and fraud walls first-class policy events. The system must not try to defeat them. It detects the boundary, pauses automation, logs evidence, creates a manual validation card, and resumes only unrelated safe work or explicitly approved manual testing with owned accounts." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#E5E7EB;strokeColor=#374151;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="220" width="3160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="place_band" value="&lt;b&gt;PLACEMENT IN THE SYSTEM&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="350" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p0" value="&lt;b&gt;Tool / Browser Worker&lt;/b&gt;&lt;br&gt;katana · ferox · httpx · Playwright · auth probes" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=11;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
