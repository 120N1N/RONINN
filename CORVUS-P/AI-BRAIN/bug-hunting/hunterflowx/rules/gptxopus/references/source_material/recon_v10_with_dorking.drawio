        <mxCell id="g_band" value="&lt;b&gt;GATE + NOTES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
