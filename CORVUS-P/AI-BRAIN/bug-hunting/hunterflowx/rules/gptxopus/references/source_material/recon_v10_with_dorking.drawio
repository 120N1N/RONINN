  <diagram name="16 Compliant Test Identity &amp; Session Layer · Architecture" id="16-identity-arch">
    <mxGraphModel dx="2400" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3400" pageHeight="2700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="h_title" value="16 Compliant Test Identity &amp; Session Layer · Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#0B1220;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="3320" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h_sub" value="Owned test accounts · mail aliases · session vault · manual browser handoff · CAPTCHA guard" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="75" width="3280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_foot" value="Recon Workflow v8 · Hybrid Architecture · Tools + AI + Graph + Validators · Authorized testing only" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="2660" width="3280" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ob_band" value="&lt;b&gt;OBJECTIVE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ob" value="&lt;b&gt;Objective&lt;/b&gt;&lt;br&gt;Manage owned test identities, email aliases, sessions, and recovery-flow evidence under Policy Gate. This layer supports Stage 5/7/10 without anti-bot evasion. If CAPTCHA, Turnstile, bot wall, or access challenge appears, automation pauses and the task moves to manual validation." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="220" width="3160" height="110" as="geometry" />
        </mxCell>
        <mxCell id="stack_band" value="&lt;b&gt;COMPONENT STACK · 3 Layers&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="360" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="col1_h" value="&lt;b&gt;LAYER 1 · BROWSER&lt;/b&gt;&lt;br&gt;Safe browser orchestration for owned-account testing" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="420" width="1050" height="70" as="geometry" />
        </mxCell>
        <mxCell id="br_1" value="&lt;b&gt;Playwright / Chromium worker&lt;/b&gt;&lt;br&gt;Standard headless browser for allowed crawling, screenshots, HAR capture, and simple owned-account flows.&lt;br&gt;Rules: no CAPTCHA solving · no anti-bot bypass · no stealth fingerprint spoofing · challenge_detected → pause." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="500" width="1050" height="165" as="geometry" />
        </mxCell>
        <mxCell id="br_2" value="&lt;b&gt;Manual browser handoff&lt;/b&gt;&lt;br&gt;When a challenge appears, send a test card to the manual queue. Validate through local browser + Burp using owned accounts. Import HAR/screenshot evidence back to MinIO/PostgreSQL." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="675" width="1050" height="165" as="geometry" />
        </mxCell>
        <mxCell id="br_3" value="&lt;b&gt;Assisted browser planner&lt;/b&gt;&lt;br&gt;LLM may summarize form structure and create safe test cards, but must not bypass protections, generate fake KYC, solve CAPTCHA, or execute risky actions automatically." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="850" width="1050" height="145" as="geometry" />
        </mxCell>
        <mxCell id="br_4" value="&lt;b&gt;Compliance config&lt;/b&gt;&lt;br&gt;Respect rate budgets · standard browser profile · per-program isolation · no proxy rotation to evade limits · no fingerprint spoofing · no solver services · stop on challenge." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="1005" width="1050" height="165" as="geometry" />
        </mxCell>
        <mxCell id="col2_h" value="&lt;b&gt;LAYER 2 · MAIL SERVER&lt;/b&gt;&lt;br&gt;Self-hosted custom domain · catch-all · IMAP/SMTP/JMAP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="420" width="1020" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ml_1" value="&lt;b&gt;Stalwart Mail Server (recommended)&lt;/b&gt;&lt;br&gt;docker run stalwartlabs/mail-server:latest&lt;br&gt;Rust · low memory ~100MB&lt;br&gt;IMAP + SMTP + JMAP + webhooks&lt;br&gt;Built-in DKIM/SPF/DMARC&lt;br&gt;Single binary · easy VPS deploy" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="500" width="1020" height="165" as="geometry" />
        </mxCell>
        <mxCell id="ml_2" value="&lt;b&gt;Mailcow (full-featured alt)&lt;/b&gt;&lt;br&gt;Docker compose · Webmail UI (SOGo)&lt;br&gt;Heavier ~2GB RAM&lt;br&gt;Best when ops team needs web access&lt;br&gt;Anti-spam Rspamd built-in&lt;br&gt;CalDAV/CardDAV bundled" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="675" width="1020" height="165" as="geometry" />
        </mxCell>
        <mxCell id="ml_3" value="&lt;b&gt;Catch-all routing&lt;/b&gt;&lt;br&gt;*@agent.yourdomain.com → single inbox&lt;br&gt;Per-signup unique alias:&lt;br&gt;  signup{secrets.token_hex(6)}@agent.yourdomain.com&lt;br&gt;IMAP polling every 5s OR webhook on receive&lt;br&gt;Agent picks confirmation links under manual/policy control" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="850" width="1020" height="145" as="geometry" />
        </mxCell>
        <mxCell id="ml_4" value="&lt;b&gt;DNS records (required)&lt;/b&gt;&lt;br&gt;MX  agent.yourdomain.com → mail.yourdomain.com (10)&lt;br&gt;A   mail.yourdomain.com → VPS_IP&lt;br&gt;TXT SPF: v=spf1 mx -all&lt;br&gt;TXT DKIM (auto by Stalwart)&lt;br&gt;TXT DMARC: v=DMARC1; p=quarantine&lt;br&gt;PTR rDNS via VPS provider" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="1005" width="1020" height="165" as="geometry" />
        </mxCell>
        <mxCell id="col3_h" value="&lt;b&gt;LAYER 3 · IDENTITY VAULT&lt;/b&gt;&lt;br&gt;Encrypted store · per-program · per-role · session-aware" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2240" y="420" width="1020" height="70" as="geometry" />
        </mxCell>
        <mxCell id="v_1" value="&lt;b&gt;Schema&lt;/b&gt;&lt;br&gt;{ identity_id, program_id, role,&lt;br&gt;  email, password (encrypted),&lt;br&gt;  profile {name, dob, country, phone},&lt;br&gt;  cookies[], tokens[], tenant_id,&lt;br&gt;  created_at, last_used, status }" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2240" y="500" width="1020" height="165" as="geometry" />
        </mxCell>
        <mxCell id="v_2" value="&lt;b&gt;Storage&lt;/b&gt;&lt;br&gt;PostgreSQL with row-level encryption (pgcrypto)&lt;br&gt;OR encrypted SQLite for solo setup&lt;br&gt;Vault key in HashiCorp Vault / sealed env var&lt;br&gt;NEVER in git, logs, AI prompts, artifacts&lt;br&gt;Audit log: every read/write/refresh" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2240" y="675" width="1020" height="165" as="geometry" />
        </mxCell>
        <mxCell id="v_3" value="&lt;b&gt;Per-program isolation&lt;/b&gt;&lt;br&gt;Each bug bounty program → separate vault namespace&lt;br&gt;No cross-program identity reuse (policy enforced)&lt;br&gt;Isolation key: program_id&lt;br&gt;Prevents cross-contamination of test data" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2240" y="850" width="1020" height="145" as="geometry" />
        </mxCell>
        <mxCell id="v_4" value="&lt;b&gt;Session refresh logic&lt;/b&gt;&lt;br&gt;Auto-detect expiry (probe /me · check 401)&lt;br&gt;If expired: refresh token OR re-login flow&lt;br&gt;If re-login fails: mark stale → reprovision&lt;br&gt;Max retry budget per identity&lt;br&gt;Audit every session event" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2240" y="1005" width="1020" height="165" as="geometry" />
