        <mxCell id="cap_anti_band" value="&lt;b&gt;CAPTCHA / ANTI-BOT STANDARD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="2220" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cap_anti_0" value="&lt;b&gt;Never bypass CAPTCHA or bot walls&lt;/b&gt;&lt;br&gt;Do not use solver services, stealth automation, fingerprint spoofing, or proxy rotation to evade protections." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="2290" width="1000" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cap_anti_1" value="&lt;b&gt;Correct handling&lt;/b&gt;&lt;br&gt;Detect → pause automation → log screenshot/evidence → tag asset → manual validation queue → local Burp/browser validation." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2290" width="1000" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cap_anti_2" value="&lt;b&gt;Professional framing&lt;/b&gt;&lt;br&gt;CAPTCHA is a boundary signal, not a target to defeat. Treat it as compliance metadata for run-mode decisions." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2270" y="2290" width="1000" height="120" as="geometry" />
