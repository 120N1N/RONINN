        <mxCell id="o4" value="&lt;b&gt;graph_query_suggestion.jsonl&lt;/b&gt;&lt;br&gt;Cypher ideas for relationship mining and coverage gap detection" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1440" width="1010" height="135" as="geometry" />
        </mxCell>
        <mxCell id="o5" value="&lt;b&gt;chain_candidate.jsonl&lt;/b&gt;&lt;br&gt;multi-signal chain hypothesis · not a confirmed vuln until validated" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2300" y="1440" width="1010" height="135" as="geometry" />
        </mxCell>
        <mxCell id="validators_band" value="&lt;b&gt;OUTPUT VALIDATORS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1660" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="v0" value="&lt;b&gt;Evidence-linked&lt;/b&gt;&lt;br&gt;Every output must include asset_id/source_stage/artifact_ref or explicitly declare missing evidence." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="140" y="1730" width="610" height="160" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="&lt;b&gt;Confidence + uncertainty&lt;/b&gt;&lt;br&gt;AI must state why it thinks the idea is interesting and what could falsify it." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="790" y="1730" width="610" height="160" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="&lt;b&gt;Risk class&lt;/b&gt;&lt;br&gt;Classify as read-only, passive, active-light, active-deep, validation, risky-validation, or forbidden." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1730" width="610" height="160" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="&lt;b&gt;No direct command&lt;/b&gt;&lt;br&gt;AI emits proposal objects. Tool workers execute only after signed policy approval." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2090" y="1730" width="610" height="160" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="&lt;b&gt;Privacy / owned data&lt;/b&gt;&lt;br&gt;Manual test cards must use owned accounts/data and avoid third-party data exposure." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2740" y="1730" width="610" height="160" as="geometry" />
        </mxCell>
        <mxCell id="schema_band" value="&lt;b&gt;MINIMUM PROPOSAL SCHEMA&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="2010" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="schema" value="&lt;pre&gt;{&#10;  &amp;quot;proposal_type&amp;quot;: &amp;quot;hypothesis | tool_run_request | manual_test_card | graph_query | report_note&amp;quot;,&#10;  &amp;quot;program_id&amp;quot;: &amp;quot;...&amp;quot;,&#10;  &amp;quot;asset_ids&amp;quot;: [&amp;quot;...&amp;quot;],&#10;  &amp;quot;evidence_refs&amp;quot;: [&amp;quot;minio://...&amp;quot;, &amp;quot;db://...&amp;quot;],&#10;  &amp;quot;reasoning_summary&amp;quot;: &amp;quot;why this is interesting&amp;quot;,&#10;  &amp;quot;risk_class&amp;quot;: &amp;quot;read_only | passive | active_light | active_deep | validation | risky_validation | forbidden&amp;quot;,&#10;  &amp;quot;requested_next_step&amp;quot;: &amp;quot;manual_validation | gated_tool_run | graph_query | report_review&amp;quot;,&#10;  &amp;quot;stop_conditions&amp;quot;: [&amp;quot;captcha_detected&amp;quot;, &amp;quot;out_of_scope&amp;quot;, &amp;quot;unexpected_sensitive_data&amp;quot;, &amp;quot;rate_limit_signal&amp;quot;]&#10;}&lt;/pre&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="2070" width="3160" height="360" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
