        <mxCell id="s_2" value="&lt;b&gt;Data&lt;/b&gt;&lt;br&gt;canonical rows = source of truth · raw outputs = artifacts" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
