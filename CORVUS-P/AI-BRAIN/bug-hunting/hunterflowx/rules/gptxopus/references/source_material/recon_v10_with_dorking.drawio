        <mxCell id="n_6" value="&lt;b&gt;Finding&lt;/b&gt;&lt;br&gt;vuln class · severity · evidence_ref · validator status" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="380" width="750" height="145" as="geometry" />
        </mxCell>
        <mxCell id="n_7" value="&lt;b&gt;Hypothesis&lt;/b&gt;&lt;br&gt;AI-generated · confidence · reasoning trace" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2560" y="380" width="750" height="145" as="geometry" />
        </mxCell>
        <mxCell id="edges_band" value="&lt;b&gt;EDGE TYPES (relationships)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="560" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="e_0" value="&lt;b&gt;HOSTS&lt;/b&gt;&lt;br&gt;Domain → Endpoint (URL belongs to domain)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="630" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e_1" value="&lt;b&gt;CALLS&lt;/b&gt;&lt;br&gt;Endpoint → Endpoint (referer / JS-discovered link)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="775" y="630" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e_2" value="&lt;b&gt;ACCEPTS&lt;/b&gt;&lt;br&gt;Endpoint → Param (parameter accepted by endpoint)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1420" y="630" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e_3" value="&lt;b&gt;LOADS&lt;/b&gt;&lt;br&gt;Endpoint → JS file (page loads script)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2065" y="630" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e_4" value="&lt;b&gt;ACCESSED_BY&lt;/b&gt;&lt;br&gt;Endpoint → Role (which roles can access)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2710" y="630" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e_5" value="&lt;b&gt;BELONGS_TO&lt;/b&gt;&lt;br&gt;Endpoint → Tenant (multi-tenant scope)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="790" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e_6" value="&lt;b&gt;EVIDENCES&lt;/b&gt;&lt;br&gt;Finding → Endpoint/Param/JS (evidence links)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="775" y="790" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e_7" value="&lt;b&gt;VARIANT_OF&lt;/b&gt;&lt;br&gt;Hypothesis → Finding (similar pattern)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1420" y="790" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e_8" value="&lt;b&gt;SHARES_AUTH&lt;/b&gt;&lt;br&gt;Domain → Domain (same OAuth issuer)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2065" y="790" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="e_9" value="&lt;b&gt;SHARES_COOKIE&lt;/b&gt;&lt;br&gt;Domain → Domain (cookie scope = .parent)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2710" y="790" width="600" height="145" as="geometry" />
        </mxCell>
        <mxCell id="queries_band" value="&lt;b&gt;REASONING QUERIES (Cypher)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="970" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="q_0" value="&lt;b&gt;Cookie tossing surface&lt;/b&gt;&lt;br&gt;MATCH (d1:Domain)-[:SHARES_COOKIE]-(d2:Domain),&lt;br&gt;      (d1)-[:HOSTS]-&gt;(e:Endpoint)-[:HAS_VULN]-&gt;(:Finding {class:'XSS'})&lt;br&gt;RETURN d1, d2, e" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="1040" width="1400" height="260" as="geometry" />
        </mxCell>
        <mxCell id="q_1" value="&lt;b&gt;Privilege boundary diff&lt;/b&gt;&lt;br&gt;MATCH (e:Endpoint)-[:ACCESSED_BY]-&gt;(r:Role)&lt;br&gt;WHERE r.name='user' AND NOT (e)-[:ACCESSED_BY]-&gt;(:Role {name:'admin'})&lt;br&gt;RETURN e // user-only endpoints" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1040" width="1400" height="260" as="geometry" />
        </mxCell>
        <mxCell id="q_2" value="&lt;b&gt;Variant hunting&lt;/b&gt;&lt;br&gt;MATCH (h:Hypothesis)-[:VARIANT_OF]-&gt;(f:Finding {class:'IDOR'})&lt;br&gt;WHERE h.confidence &gt; 0.7&lt;br&gt;RETURN h ORDER BY h.confidence DESC" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="1320" width="1400" height="260" as="geometry" />
        </mxCell>
        <mxCell id="q_3" value="&lt;b&gt;Trust pivot path&lt;/b&gt;&lt;br&gt;MATCH path=(weak:Domain {tier:'dev'})-[:SHARES_AUTH*]-(prod:Domain {tier:'prod'})&lt;br&gt;RETURN path // dev → prod via shared SSO" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1320" width="1400" height="260" as="geometry" />
        </mxCell>
        <mxCell id="usage_band" value="&lt;b&gt;GRAPH USE CASES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="1620" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="u_0" value="&lt;b&gt;Dedup findings&lt;/b&gt;&lt;br&gt;Same vuln on shared infra → single finding (not duplicate per host)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="1690" width="750" height="145" as="geometry" />
        </mxCell>
        <mxCell id="u_1" value="&lt;b&gt;Variant hunting&lt;/b&gt;&lt;br&gt;Find similar endpoints to known finding (AI graph traversal)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="940" y="1690" width="750" height="145" as="geometry" />
        </mxCell>
        <mxCell id="u_2" value="&lt;b&gt;Attack path scoring&lt;/b&gt;&lt;br&gt;Rank pivot chains: weak entry → high-value target via graph distance" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="1690" width="750" height="145" as="geometry" />
        </mxCell>
        <mxCell id="u_3" value="&lt;b&gt;Coverage gaps&lt;/b&gt;&lt;br&gt;Find endpoints not connected to any Role → potential unauth access" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2560" y="1690" width="750" height="145" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
