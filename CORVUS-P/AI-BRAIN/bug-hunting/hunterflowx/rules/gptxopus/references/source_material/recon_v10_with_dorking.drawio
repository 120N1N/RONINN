        <mxCell id="sp_0" value="&lt;b&gt;VPS Requirements&lt;/b&gt;&lt;br&gt;4-8 GB RAM · 80 GB SSD&lt;br&gt;Clean IP (not blacklisted)&lt;br&gt;Port 25 unblocked for SMTP&lt;br&gt;Docker support&lt;br&gt;Linux (Ubuntu 22.04+)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="1500" width="750" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sp_1" value="&lt;b&gt;Domain Setup&lt;/b&gt;&lt;br&gt;$10/year .com domain&lt;br&gt;Dedicated subdomain for mail&lt;br&gt;Full DNS access required&lt;br&gt;(Cloudflare / Route 53 / Hetzner DNS)&lt;br&gt;MX + SPF + DKIM + DMARC + PTR" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="940" y="1500" width="750" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sp_2" value="&lt;b&gt;Provider Recommendations&lt;/b&gt;&lt;br&gt;✓ Hetzner CX22 (€4.5/mo)&lt;br&gt;✓ OVH VPS Comfort&lt;br&gt;✓ Vultr (request port 25 unblock)&lt;br&gt;⚠ AWS / GCP block port 25 by default&lt;br&gt;⚠ DigitalOcean needs ticket for SMTP" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="1500" width="750" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sp_3" value="&lt;b&gt;Monthly Cost Estimate&lt;/b&gt;&lt;br&gt;VPS: €5–€20 depending on workers&lt;br&gt;Domain: ~$1/month amortized&lt;br&gt;Mail service/self-hosting: low cost&lt;br&gt;LLM API: usage-based&lt;br&gt;No solver/proxy budget included because evasion is not part of the system" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2560" y="1500" width="750" height="200" as="geometry" />
        </mxCell>
        <mxCell id="cli_band" value="&lt;b&gt;QUICK START · docker-compose.yml skeleton&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#ECFCCB;strokeColor=#65A30D;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="1740" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cli_text" value="&lt;b&gt;Bare-minimum stack for compliant identity/session layer&lt;/b&gt;&lt;br&gt;&lt;br&gt;version: '3.8'&lt;br&gt;services:&lt;br&gt;  stalwart:&lt;br&gt;    image: stalwartlabs/mail-server:latest&lt;br&gt;    ports: ['25:25', '587:587', '465:465', '993:993', '143:143']&lt;br&gt;    volumes: ['./mail-data:/opt/stalwart-mail']&lt;br&gt;    environment:&lt;br&gt;      DOMAIN: agent.yourdomain.com&lt;br&gt;&lt;br&gt;  vault-db:&lt;br&gt;    image: postgres:16&lt;br&gt;    volumes: ['./vault:/var/lib/postgresql/data']&lt;br&gt;    environment:&lt;br&gt;      POSTGRES_PASSWORD: ${VAULT_PWD}&lt;br&gt;      POSTGRES_DB: identity_vault&lt;br&gt;&lt;br&gt;  browser-worker:&lt;br&gt;    image: mcr.microsoft.com/playwright/python:v1.40.0-jammy&lt;br&gt;    shm_size: 1gb&lt;br&gt;    volumes: ['./agent:/app']&lt;br&gt;    command: python /app/orchestrator.py&lt;br&gt;    depends_on: [stalwart, vault-db]&lt;br&gt;    environment:&lt;br&gt;      MAIL_HOST: stalwart&lt;br&gt;      VAULT_HOST: vault-db&lt;br&gt;      VAULT_PWD: ${VAULT_PWD}&lt;br&gt;&lt;br&gt;# Mandatory rule inside orchestrator.py:&lt;br&gt;# if challenge_detected(url): pause_worker(host_or_path); emit captcha_event; create manual test card; do_not_bypass();" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#ECFCCB;strokeColor=#65A30D;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="1810" width="3160" height="800" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
