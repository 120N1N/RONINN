        <mxCell id="integ_band" value="&lt;b&gt;STAGE INTEGRATION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="2040" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="integ_0" value="&lt;b&gt;Stage -1 Policy Gate&lt;/b&gt;&lt;br&gt;Adds challenge_detected check before/after every action. Decision can be allow, deny, needs_approval, or manual_required." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="2110" width="760" height="130" as="geometry" />
        </mxCell>
        <mxCell id="integ_1" value="&lt;b&gt;Stage 4 Content Discovery&lt;/b&gt;&lt;br&gt;Crawler/dir discovery stops on challenge. Passive URL, already-fetched JS, and manual cards may continue." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="930" y="2110" width="760" height="130" as="geometry" />
        </mxCell>
        <mxCell id="integ_2" value="&lt;b&gt;Stage 5/7 Auth + Recovery&lt;/b&gt;&lt;br&gt;Signup, login, reset, MFA, and session refresh challenge → local manual flow only. Vault redacts tokens from AI." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1730" y="2110" width="760" height="130" as="geometry" />
        </mxCell>
        <mxCell id="integ_3" value="&lt;b&gt;Stage 8 Validation&lt;/b&gt;&lt;br&gt;Fuzzing/exploit validation excludes captcha_protected assets unless a human reviewer moves a minimal manual test card forward." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2530" y="2110" width="760" height="130" as="geometry" />
        </mxCell>
        <mxCell id="anti_band" value="&lt;b&gt;ANTI-PATTERNS + MANUAL HANDOFF STANDARD&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="2280" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="anti_0" value="&lt;b&gt;Forbidden&lt;/b&gt;&lt;br&gt;CAPTCHA solvers · anti-bot bypass · stealth fingerprint spoofing · proxy rotation to evade · mass signup · repeated challenge probing · fake KYC/phone bypass." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="2350" width="1020" height="145" as="geometry" />
        </mxCell>
        <mxCell id="anti_1" value="&lt;b&gt;Correct manual handoff&lt;/b&gt;&lt;br&gt;Open test card locally → use Burp/browser → owned account only → solve challenge manually only where program allows → minimal requests → export HAR/screenshot." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2350" width="1020" height="145" as="geometry" />
        </mxCell>
        <mxCell id="anti_2" value="&lt;b&gt;Report rule&lt;/b&gt;&lt;br&gt;Do not claim challenge bypass unless explicitly in scope. Report the underlying bug only when proof is compliant, reproducible, redacted, and evidence-linked." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2270" y="2350" width="1020" height="145" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Recon Workflow v8 · Hybrid Architecture · CAPTCHA Guard · Authorized testing only" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="2660" width="3280" height="22" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="19 AI Freedom Boundary Model" id="19-ai-freedom-boundary">
    <mxGraphModel dx="2400" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3400" pageHeight="2700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="h_title" value="19 AI Freedom Boundary Model" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#0B1220;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="3320" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h_sub" value="AI may think beyond the checklist, but every action must pass policy · risk · scope · rate · CAPTCHA gates" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="75" width="3280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_foot" value="Recon Workflow v9 · AI Creative Reasoning Sandbox · Governed Execution · Authorized testing only" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="60" y="2650" width="3280" height="28" as="geometry" />
        </mxCell>
        <mxCell id="principle_band" value="&lt;b&gt;CORE PRINCIPLE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="130" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="principle" value="&lt;b&gt;Think freely, act safely.&lt;/b&gt;&lt;br&gt;&lt;br&gt;The workflow is not a prison for AI reasoning. It is a governance envelope for execution. AI may reason across all evidence, propose novel branches, challenge assumptions, and synthesize chains. AI may not execute tools, bypass gates, ignore scope, evade CAPTCHA/bot protections, or perform risky/destructive validation without approval." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="190" width="3160" height="150" as="geometry" />
        </mxCell>
        <mxCell id="left_band" value="&lt;b&gt;AI CREATIVE REASONING ZONE · READ-ONLY BY DEFAULT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="390" width="1450" height="46" as="geometry" />
        </mxCell>
        <mxCell id="right_band" value="&lt;b&gt;CONTROLLED EXECUTION ZONE · POLICY-GATED&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1880" y="390" width="1450" height="46" as="geometry" />
        </mxCell>
        <mxCell id="cr_0" value="&lt;b&gt;Cross-stage correlation&lt;/b&gt;&lt;br&gt;Connect DNS, HTTP, JS, API, auth, role diff, monitoring diff, and Burp/HAR evidence." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="150" y="470" width="1390" height="115" as="geometry" />
        </mxCell>
        <mxCell id="cr_1" value="&lt;b&gt;Novel hypothesis generation&lt;/b&gt;&lt;br&gt;Create new bug hypotheses even when they are not explicitly listed in a stage checklist." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="150" y="615" width="1390" height="115" as="geometry" />
        </mxCell>
        <mxCell id="cr_2" value="&lt;b&gt;Semantic discovery ideas&lt;/b&gt;&lt;br&gt;Generate domain-specific path/API candidates from app vocabulary, roles, features, and code terms." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="150" y="760" width="1390" height="115" as="geometry" />
        </mxCell>
        <mxCell id="cr_3" value="&lt;b&gt;Challenge assumptions&lt;/b&gt;&lt;br&gt;Ask what is missing: untested role, hidden tenant boundary, stale JS route, false custom 404, protected flow." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="150" y="905" width="1390" height="115" as="geometry" />
        </mxCell>
        <mxCell id="cr_4" value="&lt;b&gt;Chain synthesis&lt;/b&gt;&lt;br&gt;Suggest possible chains across low/medium signals, but label them as hypotheses until validated." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="150" y="1050" width="1390" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ex_0" value="&lt;b&gt;Scope Gate&lt;/b&gt;&lt;br&gt;Only in-scope domains, URLs, IPs, apps, roles, and owned accounts can be tested." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1910" y="470" width="1390" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ex_1" value="&lt;b&gt;Mode Gate&lt;/b&gt;&lt;br&gt;Passive, active-light, active-deep, authenticated, validation, risky-validation determine allowed actions." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1910" y="615" width="1390" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ex_2" value="&lt;b&gt;Risk Gate&lt;/b&gt;&lt;br&gt;SSRF OOB, smuggling, race, upload bypass, SQLi automation, auth edge cases require explicit approval." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1910" y="760" width="1390" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ex_3" value="&lt;b&gt;CAPTCHA/Bot Guard&lt;/b&gt;&lt;br&gt;Challenge detected → pause automation, log evidence, route to manual queue. No solver or evasion." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1910" y="905" width="1390" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ex_4" value="&lt;b&gt;Rate + Stop Rules&lt;/b&gt;&lt;br&gt;Per-host budgets, no retry loops, halt on challenge/abuse signal, audit every decision." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1910" y="1050" width="1390" height="115" as="geometry" />
        </mxCell>
        <mxCell id="boundary" value="&lt;b&gt;BOUNDARY&lt;/b&gt;&lt;br&gt;&lt;br&gt;AI ideas become structured objects before any action:&lt;br&gt;&lt;br&gt;hypothesis · test_card · tool_run_request · graph_query · manual_task · report_note&lt;br&gt;&lt;br&gt;No direct execution." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1610" y="520" width="240" height="510" as="geometry" />
        </mxCell>
        <mxCell id="e_cr_0" style="endArrow=block;html=1;rounded=0;strokeWidth=1.6;strokeColor=#64748B;dashed=1;" edge="1" parent="1" source="cr_0" target="boundary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cr_1" style="endArrow=block;html=1;rounded=0;strokeWidth=1.6;strokeColor=#64748B;dashed=1;" edge="1" parent="1" source="cr_1" target="boundary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cr_2" style="endArrow=block;html=1;rounded=0;strokeWidth=1.6;strokeColor=#64748B;dashed=1;" edge="1" parent="1" source="cr_2" target="boundary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cr_3" style="endArrow=block;html=1;rounded=0;strokeWidth=1.6;strokeColor=#64748B;dashed=1;" edge="1" parent="1" source="cr_3" target="boundary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_cr_4" style="endArrow=block;html=1;rounded=0;strokeWidth=1.6;strokeColor=#64748B;dashed=1;" edge="1" parent="1" source="cr_4" target="boundary">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ex_0" style="endArrow=block;html=1;rounded=0;strokeWidth=1.8;strokeColor=#334155;" edge="1" parent="1" source="boundary" target="ex_0">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ex_1" style="endArrow=block;html=1;rounded=0;strokeWidth=1.8;strokeColor=#334155;" edge="1" parent="1" source="boundary" target="ex_1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ex_2" style="endArrow=block;html=1;rounded=0;strokeWidth=1.8;strokeColor=#334155;" edge="1" parent="1" source="boundary" target="ex_2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ex_3" style="endArrow=block;html=1;rounded=0;strokeWidth=1.8;strokeColor=#334155;" edge="1" parent="1" source="boundary" target="ex_3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_ex_4" style="endArrow=block;html=1;rounded=0;strokeWidth=1.8;strokeColor=#334155;" edge="1" parent="1" source="boundary" target="ex_4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rules_band" value="&lt;b&gt;HARD RULES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1260" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="may" value="&lt;b&gt;AI MAY&lt;/b&gt;&lt;br&gt;• Reason outside the linear workflow&lt;br&gt;• Propose a new branch or stage-specific rerun&lt;br&gt;• Generate graph queries and semantic wordlists&lt;br&gt;• Build manual test cards and report notes&lt;br&gt;• Ask for a tool run through the proposal queue&lt;br&gt;• Re-analyze negative results and coverage gaps" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="1325" width="720" height="310" as="geometry" />
        </mxCell>
        <mxCell id="must" value="&lt;b&gt;AI MUST&lt;/b&gt;&lt;br&gt;• Keep execution read-only until approved&lt;br&gt;• Attach evidence_refs and asset_ids to every idea&lt;br&gt;• Label confidence and uncertainty&lt;br&gt;• Use owned test accounts only for auth testing&lt;br&gt;• Respect CAPTCHA/bot challenge boundaries&lt;br&gt;• Convert ideas into auditable queue items" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="900" y="1325" width="720" height="310" as="geometry" />
        </mxCell>
        <mxCell id="must_not" value="&lt;b&gt;AI MUST NOT&lt;/b&gt;&lt;br&gt;• Execute tools directly&lt;br&gt;• Bypass scope, rate, auth, or CAPTCHA rules&lt;br&gt;• Run credential/token brute force&lt;br&gt;• Use proxy rotation to evade controls&lt;br&gt;• Perform destructive or risky testing without approval&lt;br&gt;• Treat hypothesis as confirmed finding" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FEF2F2;strokeColor=#F87171;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1680" y="1325" width="720" height="310" as="geometry" />
        </mxCell>
        <mxCell id="human" value="&lt;b&gt;HUMAN OWNS FINAL JUDGMENT&lt;/b&gt;&lt;br&gt;Manual validation confirms impact, ensures program-rule compliance, checks evidence quality, and decides whether a finding is report-ready." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2460" y="1325" width="820" height="310" as="geometry" />
        </mxCell>
        <mxCell id="flow_band" value="&lt;b&gt;GOVERNED CREATIVE LOOP&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1710" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="f0" value="&lt;b&gt;Evidence / Graph&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="160" y="1810" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f1" value="&lt;b&gt;AI Creative Reasoning&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="620" y="1810" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f2" value="&lt;b&gt;Proposal Queue&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1810" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f3" value="&lt;b&gt;Policy + Risk Gate&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1540" y="1810" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f4" value="&lt;b&gt;Approved Tool/Manual Path&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2000" y="1810" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f5" value="&lt;b&gt;Evidence Import&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2460" y="1810" width="330" height="90" as="geometry" />
        </mxCell>
        <mxCell id="f6" value="&lt;b&gt;AI Re-analysis&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2920" y="1810" width="330" height="90" as="geometry" />
        </mxCell>
