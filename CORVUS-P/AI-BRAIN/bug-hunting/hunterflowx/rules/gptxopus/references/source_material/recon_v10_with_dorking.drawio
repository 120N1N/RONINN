        <mxCell id="rules_band" value="&lt;b&gt;IMPLEMENTATION RULES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="2090" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="rule1" value="&lt;b&gt;Default autonomy = L0/L1&lt;/b&gt;&lt;br&gt;AI starts as a read-only analyst and proposal generator. It can be creative immediately because it cannot execute directly." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="2155" width="740" height="180" as="geometry" />
        </mxCell>
        <mxCell id="rule2" value="&lt;b&gt;Execution requires signed request&lt;/b&gt;&lt;br&gt;Tool workers accept only approved requests that include policy_snapshot_id, scope set, rate budget, and stop conditions." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="900" y="2155" width="740" height="180" as="geometry" />
        </mxCell>
        <mxCell id="rule3" value="&lt;b&gt;Risk escalates gates&lt;/b&gt;&lt;br&gt;Active-deep and risky-validation classes require mode/approval alignment and stronger evidence of why the test is needed." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1680" y="2155" width="740" height="180" as="geometry" />
        </mxCell>
        <mxCell id="rule4" value="&lt;b&gt;Forbidden remains forbidden&lt;/b&gt;&lt;br&gt;No amount of AI confidence can convert L5 actions into allowed workflow steps." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FEF2F2;strokeColor=#F87171;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2460" y="2155" width="820" height="180" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
