        <mxCell id="mod" value="&lt;b&gt;Tools / Modules (concrete CLI)&lt;/b&gt;&lt;br&gt;# cron 02:00 daily:&lt;br&gt;bbot -t target -p subdomain-enum -om json&lt;br&gt;jq DNS_NAME diff vs prev &gt; new_subs.txt&lt;br&gt;notify -bulk -id slack &lt; new_subs.txt&lt;br&gt;&lt;br&gt;# certstream-server realtime CT feed → filter domain regex&lt;br&gt;# JS hash watcher: sha256 each JS daily · on diff re-run Stage 4&lt;br&gt;# CVE stack watch: hourly NVD + CISA KEV poll · match tech_stack.json&lt;br&gt;# trufflehog github --org=$ORG --only-verified continuous&lt;br&gt;# bbot -p cloud-enum weekly · diff buckets.json&lt;br&gt;# SecurityTrails DNS history poll · detect IP changes (origin leak)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=1.5;" vertex="1" parent="1">
