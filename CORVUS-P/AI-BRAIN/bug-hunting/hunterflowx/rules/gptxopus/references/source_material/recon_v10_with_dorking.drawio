        <mxCell id="p2" value="&lt;b&gt;Policy Gate&lt;/b&gt;&lt;br&gt;deny_or_manual_required · no retry loop" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=11;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
