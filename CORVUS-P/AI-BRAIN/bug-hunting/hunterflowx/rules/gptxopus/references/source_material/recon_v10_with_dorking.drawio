        <mxCell id="h_title" value="02 Stage -1 · Policy Gate" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#0B1220;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="3320" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h_sub" value="Every action passes policy checks BEFORE execution — scope · mode · rate · forbidden classes" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="75" width="3280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_foot" value="Recon Workflow v8 · Hybrid Architecture · Tools + AI + Graph + Validators · Authorized testing only" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="2660" width="3280" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ob_band" value="&lt;b&gt;OBJECTIVE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#E5E7EB;strokeColor=#374151;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ob" value="&lt;b&gt;Objective&lt;/b&gt;&lt;br&gt;Enforce program rules at runtime. No tool runs, no AI suggestion executes, no manual test fires until policy validates the action. Policy snapshot is immutable per run." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#E5E7EB;strokeColor=#374151;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="220" width="3160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="io_band" value="&lt;b&gt;INPUTS · MODULES · OUTPUTS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="330" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="inp" value="&lt;b&gt;Inputs&lt;/b&gt;&lt;br&gt;scope_raw.json (HackerOne/Bugcrowd API)&lt;br&gt;run mode (passive · active · authenticated)&lt;br&gt;rate budget (req/sec per host)&lt;br&gt;time budget (max wall-clock)&lt;br&gt;forbidden actions list" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="1020" height="280" as="geometry" />
        </mxCell>
        <mxCell id="mod" value="&lt;b&gt;Modules&lt;/b&gt;&lt;br&gt;Scope normalizer · wildcard matcher&lt;br&gt;Mode gate (passive / active / auth)&lt;br&gt;Rate limiter (Redis token bucket)&lt;br&gt;Forbidden-class checker&lt;br&gt;CAPTCHA/Bot Challenge Guard&lt;br&gt;Approval requestor (human-in-loop)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1160" y="400" width="1020" height="280" as="geometry" />
        </mxCell>
        <mxCell id="outs" value="&lt;b&gt;Outputs&lt;/b&gt;&lt;br&gt;policy_snapshot.json (immutable)&lt;br&gt;scope_in.txt · scope_out.txt&lt;br&gt;action_decision.json (allow/deny/needs_approval)&lt;br&gt;captcha_events.jsonl · blocked_automation_targets.jsonl&lt;br&gt;audit.log (every check + decision)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2200" y="400" width="1020" height="280" as="geometry" />
        </mxCell>
        <mxCell id="wf_band" value="&lt;b&gt;POLICY CHECK FLOW&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
