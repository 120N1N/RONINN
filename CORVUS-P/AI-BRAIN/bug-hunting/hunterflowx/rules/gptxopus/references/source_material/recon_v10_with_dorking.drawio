        <mxCell id="h_sub" value="Read-only multi-analyst layer for creative reasoning over canonical data, graph, artifacts, and manual evidence" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
