          <mxGeometry x="60" y="75" width="3280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_foot" value="Recon Workflow v9 · AI Creative Reasoning Sandbox · Governed Execution · Authorized testing only" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#64748B;" vertex="1" parent="1">
          <mxGeometry x="60" y="2650" width="3280" height="28" as="geometry" />
        </mxCell>
        <mxCell id="contract_band" value="&lt;b&gt;UPDATED AI OPERATING CONTRACT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="130" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="contract" value="&lt;b&gt;Contract statement&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;AI can think outside the workflow, but AI must act through the workflow.&lt;/b&gt;&lt;br&gt;&lt;br&gt;The workflow controls execution, not imagination. AI may propose new branches, challenge assumptions, create novel hypotheses, and generate semantic discovery ideas. Every proposed action becomes an auditable object that passes scope, mode, risk, rate, CAPTCHA, and approval gates before execution." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="190" width="3160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="examples_band" value="&lt;b&gt;EXAMPLES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="410" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="ex1" value="&lt;b&gt;Example 1 · Hidden route creativity&lt;/b&gt;&lt;br&gt;&lt;br&gt;Evidence:&lt;br&gt;JS bundle contains terms billing, partnerPortal, invoiceExport, roleMutation.&lt;br&gt;&lt;br&gt;AI idea:&lt;br&gt;Suggest semantic route candidates and graph query for related endpoints.&lt;br&gt;&lt;br&gt;Allowed output:&lt;br&gt;semantic_wordlist.jsonl + graph_query_suggestion.jsonl + manual_test_card.jsonl.&lt;br&gt;&lt;br&gt;Execution path:&lt;br&gt;Policy-gated active-light content discovery only if host/path is in scope and mode allows it." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="480" width="1000" height="360" as="geometry" />
        </mxCell>
        <mxCell id="ex2" value="&lt;b&gt;Example 2 · BAC/IDOR chain hypothesis&lt;/b&gt;&lt;br&gt;&lt;br&gt;Evidence:&lt;br&gt;Endpoint accepts orgId/memberId and appears in normal user bundle; role matrix missing editor role.&lt;br&gt;&lt;br&gt;AI idea:&lt;br&gt;Hypothesize tenant/role boundary issue and request owned-account comparison.&lt;br&gt;&lt;br&gt;Allowed output:&lt;br&gt;manual_test_card with Account A/B, expected secure behavior, stop conditions.&lt;br&gt;&lt;br&gt;Execution path:&lt;br&gt;Manual validation via local Burp; no third-party data; evidence imported after proof." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1200" y="480" width="1000" height="360" as="geometry" />
        </mxCell>
        <mxCell id="ex3" value="&lt;b&gt;Example 3 · CAPTCHA boundary&lt;/b&gt;&lt;br&gt;&lt;br&gt;Evidence:&lt;br&gt;Browser worker detects Turnstile/reCAPTCHA/bot wall on login or content path.&lt;br&gt;&lt;br&gt;AI idea:&lt;br&gt;Do not bypass. Create manual_required test card and mark asset captcha_protected.&lt;br&gt;&lt;br&gt;Allowed output:&lt;br&gt;captcha_event.jsonl + manual queue item.&lt;br&gt;&lt;br&gt;Execution path:&lt;br&gt;Human-owned account/browser validation only if program rules allow it." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FEF2F2;strokeColor=#F87171;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2280" y="480" width="1000" height="360" as="geometry" />
        </mxCell>
        <mxCell id="anti_band" value="&lt;b&gt;ANTI-PATTERNS TO BLOCK&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="950" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="a0" value="&lt;b&gt;AI directly runs tool commands&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#FEF2F2;strokeColor=#F87171;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="140" y="1030" width="740" height="82" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="&lt;b&gt;AI broadens scope without scope proof&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#FEF2F2;strokeColor=#F87171;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="940" y="1030" width="740" height="82" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="&lt;b&gt;AI retries through CAPTCHA/bot wall&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#FEF2F2;strokeColor=#F87171;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1740" y="1030" width="740" height="82" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="&lt;b&gt;AI uses solver/proxy/fingerprint evasion&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#FEF2F2;strokeColor=#F87171;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2540" y="1030" width="740" height="82" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="&lt;b&gt;AI performs credential/token brute force&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#FEF2F2;strokeColor=#F87171;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="140" y="1150" width="740" height="82" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="&lt;b&gt;AI treats hypothesis as confirmed vuln&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#FEF2F2;strokeColor=#F87171;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="940" y="1150" width="740" height="82" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="&lt;b&gt;AI tests with non-owned accounts/data&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#FEF2F2;strokeColor=#F87171;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1740" y="1150" width="740" height="82" as="geometry" />
        </mxCell>
        <mxCell id="a7" value="&lt;b&gt;AI runs risky validation without approval&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fillColor=#FEF2F2;strokeColor=#F87171;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2540" y="1150" width="740" height="82" as="geometry" />
        </mxCell>
        <mxCell id="success_band" value="&lt;b&gt;WHAT GOOD LOOKS LIKE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1330" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="good1" value="&lt;b&gt;Creative&lt;/b&gt;&lt;br&gt;AI finds non-obvious relationships across graph, code, monitoring diffs, and manual flows." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="1410" width="610" height="170" as="geometry" />
        </mxCell>
        <mxCell id="good2" value="&lt;b&gt;Evidence-linked&lt;/b&gt;&lt;br&gt;Every idea has asset_id, source_stage, artifact_ref, confidence, and falsification path." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#EFF6FF;strokeColor=#60A5FA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="780" y="1410" width="610" height="170" as="geometry" />
        </mxCell>
        <mxCell id="good3" value="&lt;b&gt;Gated&lt;/b&gt;&lt;br&gt;Any active action is converted into a signed tool_run_request or manual_test_card." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1410" width="610" height="170" as="geometry" />
        </mxCell>
        <mxCell id="good4" value="&lt;b&gt;Compliant&lt;/b&gt;&lt;br&gt;CAPTCHA/bot walls, scope boundaries, and program rules are respected by default." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2100" y="1410" width="610" height="170" as="geometry" />
        </mxCell>
        <mxCell id="good5" value="&lt;b&gt;Useful&lt;/b&gt;&lt;br&gt;Output is not generic advice; it becomes prioritized test cards, graph queries, and reportable evidence." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2760" y="1410" width="510" height="170" as="geometry" />
        </mxCell>
        <mxCell id="implementation_band" value="&lt;b&gt;IMPLEMENTATION HOOKS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#0F172A;fontColor=#FFFFFF;strokeColor=#0F172A;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1690" width="3160" height="46" as="geometry" />
        </mxCell>
        <mxCell id="hook1" value="&lt;b&gt;Service change&lt;/b&gt;&lt;br&gt;Split AI workers into two permissions:&lt;br&gt;1) read-only reasoning workers&lt;br&gt;2) proposal writers&lt;br&gt;&lt;br&gt;Tool workers do not accept instructions from AI directly." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="1760" width="760" height="250" as="geometry" />
        </mxCell>
        <mxCell id="hook2" value="&lt;b&gt;Database change&lt;/b&gt;&lt;br&gt;Add tables/collections:&lt;br&gt;ai_proposals · proposal_decisions · autonomy_level · risk_class · tool_run_requests · manual_test_cards · coverage_gaps." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="920" y="1760" width="760" height="250" as="geometry" />
        </mxCell>
        <mxCell id="hook3" value="&lt;b&gt;Policy change&lt;/b&gt;&lt;br&gt;Policy service signs approved execution objects. Include scope snapshot, mode, rate budget, captcha status, reviewer, and stop rules." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1720" y="1760" width="760" height="250" as="geometry" />
        </mxCell>
        <mxCell id="hook4" value="&lt;b&gt;Dashboard change&lt;/b&gt;&lt;br&gt;Add proposal review queue with filters: high-confidence, needs manual, blocked by policy, blocked by CAPTCHA, risky-validation approval." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2520" y="1760" width="760" height="250" as="geometry" />
        </mxCell>
        <mxCell id="final" value="&lt;b&gt;Final design note&lt;/b&gt;&lt;br&gt;Do not over-constrain AI reasoning with a rigid checklist. Constrain only actions. This preserves creativity while maintaining bug-bounty-safe, auditable, and repeatable execution." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="120" y="2200" width="3160" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="26 Dorking &amp; Public Intelligence Layer" id="26-dorking">
    <mxGraphModel dx="2400" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3400" pageHeight="2700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="h_title" value="26 Dorking &amp; Public Intelligence Layer" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontStyle=1;fontColor=#0B1220;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="3320" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h_sub" value="Search engine + GitHub + Shodan + Censys + code search + leak sites · feeds Stage 1/2/4/5 · targeted high-signal queries" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="75" width="3280" height="30" as="geometry" />
        </mxCell>
        <mxCell id="h_foot" value="Recon Workflow v7 · Hybrid Architecture · Tools + AI + Graph + Validators · Authorized testing only" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=10;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
          <mxGeometry x="60" y="2660" width="3280" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ob_band" value="&lt;b&gt;OBJECTIVE&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="150" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ob" value="&lt;b&gt;Objective&lt;/b&gt;&lt;br&gt;Manual/curated dorking complements automated tools. Senior hunters spend ~30% of recon time here. Tools (BBOT, ferox, katana) cover BREADTH; dorking covers DEPTH and TARGETED queries that reveal high-impact assets: admin panels, leaked configs, exposed databases, internal docs, abandoned subdomains. This layer is cross-stage and AI-assisted but governed by Policy Gate." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="220" width="3160" height="130" as="geometry" />
        </mxCell>
        <mxCell id="integ_band" value="&lt;b&gt;WHERE DORKING PLUGS INTO THE WORKFLOW&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="380" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="integ_0" value="&lt;b&gt;Stage 1 · Horizontal&lt;/b&gt;&lt;br&gt;Asset discovery via search engines&lt;br&gt;Find sister domains via copyright/analytics ID dorks&lt;br&gt;Reverse-WHOIS via search engines" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="440" width="750" height="145" as="geometry" />
        </mxCell>
        <mxCell id="integ_1" value="&lt;b&gt;Stage 2 · Subdomain&lt;/b&gt;&lt;br&gt;Subdomain hint extraction&lt;br&gt;Wayback subdomain mining&lt;br&gt;shodan org: queries · cert.subject pivots" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="940" y="440" width="750" height="145" as="geometry" />
        </mxCell>
        <mxCell id="integ_2" value="&lt;b&gt;Stage 4 · Content&lt;/b&gt;&lt;br&gt;Endpoint dorking via Google/Bing&lt;br&gt;GitHub manual code search&lt;br&gt;Document leakage (filetype:pdf)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1750" y="440" width="750" height="145" as="geometry" />
        </mxCell>
        <mxCell id="integ_3" value="&lt;b&gt;Stage 5 · API + Auth&lt;/b&gt;&lt;br&gt;Postman/Swagger workspace search&lt;br&gt;GitHub API key dorks&lt;br&gt;Mobile API endpoint patterns" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2560" y="440" width="750" height="145" as="geometry" />
        </mxCell>
        <mxCell id="se_band" value="&lt;b&gt;SEARCH ENGINE DORKING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="615" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="se_0" value="&lt;b&gt;Google dorks (curated)&lt;/b&gt;&lt;br&gt;site:target.com inurl:admin · intitle:&quot;index of&quot;&lt;br&gt;site:target.com filetype:env · inurl:wp-config&lt;br&gt;intext:&quot;DB_PASSWORD&quot; site:target.com&lt;br&gt;Tool: SerpAPI / ScraperAPI (paid · API-based)&lt;br&gt;Manual: browser session (rate-limited · CAPTCHA risk)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="675" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="se_1" value="&lt;b&gt;Bing + DuckDuckGo&lt;/b&gt;&lt;br&gt;site:target.com (alternative when Google blocked)&lt;br&gt;DDG HTML version: scrapable without CAPTCHA&lt;br&gt;Bing API: low-cost, decent coverage&lt;br&gt;Often surface different results than Google" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1700" y="675" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="se_2" value="&lt;b&gt;Wayback dorking&lt;/b&gt;&lt;br&gt;web.archive.org/cdx/search/cdx?url=*.target.com&lt;br&gt;Filter by year · find DELETED endpoints&lt;br&gt;Finds removed admin panels, old API versions&lt;br&gt;Waymore tool: better than waybackurls" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="850" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="se_3" value="&lt;b&gt;PublicWWW + NerdyData&lt;/b&gt;&lt;br&gt;publicwww.com/websites/&quot;target.com&quot;&lt;br&gt;Finds sites embedding target.com analytics/scripts&lt;br&gt;NerdyData: source code search across web&lt;br&gt;Reveals: 3rd-party integrations, abandoned tracking" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1700" y="850" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sh_band" value="&lt;b&gt;SHODAN · CENSYS · FOFA · CUSTOM QUERIES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#FED7AA;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="1035" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sh_0" value="&lt;b&gt;Shodan power queries&lt;/b&gt;&lt;br&gt;org:&quot;Target Inc&quot; port:8080,8443&lt;br&gt;http.favicon.hash:-1234567 (favicon pivot)&lt;br&gt;http.title:&quot;Target Admin&quot;&lt;br&gt;ssl.cert.subject.CN:&quot;target.com&quot;&lt;br&gt;product:Apache version:2.4.49 (CVE hunting)&lt;br&gt;port:9200 (Elasticsearch exposed)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FED7AA;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="1095" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sh_1" value="&lt;b&gt;Censys queries&lt;/b&gt;&lt;br&gt;services.tls.certificates.leaf_data.subject.common_name: &quot;target.com&quot;&lt;br&gt;services.http.response.body: &quot;target&quot;&lt;br&gt;favicon hash: services.http.response.favicons.md5_hash:&lt;br&gt;autonomous_system.organization: &quot;Target&quot;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FED7AA;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1095" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sh_2" value="&lt;b&gt;FOFA custom queries&lt;/b&gt;&lt;br&gt;domain=&quot;target.com&quot; &amp;&amp; body=&quot;api&quot;&lt;br&gt;title=&quot;Target Admin&quot; &amp;&amp; country=&quot;ID&quot;&lt;br&gt;icon_hash=&quot;-1234567&quot; (favicon pivot)&lt;br&gt;cert=&quot;target.com&quot; (cert-based discovery)&lt;br&gt;body=&quot;DEBUG = True&quot; (Django debug exposed)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FED7AA;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="1270" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="sh_3" value="&lt;b&gt;ZoomEye · Hunter.how · Quake&lt;/b&gt;&lt;br&gt;Alt platforms · sometimes find assets others miss&lt;br&gt;ZoomEye: hostname:target.com +country:ID&lt;br&gt;Hunter.how: domain.suffix=&quot;target.com&quot;&lt;br&gt;Quake: app:&quot;Apache Tomcat&quot; &amp;&amp; country:&quot;CN&quot;&lt;br&gt;Use 2-3 platforms · cross-validate findings" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FED7AA;strokeColor=#C2410C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1270" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="gh_band" value="&lt;b&gt;GITHUB DEEP DORKING&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="1455" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="gh_0" value="&lt;b&gt;gitdorker (100+ dorks)&lt;/b&gt;&lt;br&gt;git clone github.com/obheda12/GitDorker&lt;br&gt;python3 GitDorker.py -t target.com -tf tokens.txt&lt;br&gt;Uses curated dork list · API-based · respect rate&lt;br&gt;Finds: API keys, config files, internal hostnames" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="1515" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="gh_1" value="&lt;b&gt;github-dorks curated list&lt;/b&gt;&lt;br&gt;github.com/techgaun/github-dorks&lt;br&gt;Manual queries via gh search code:&lt;br&gt;  &quot;target.com&quot; &quot;api_key&quot;&lt;br&gt;  &quot;target.com&quot; filename:.env&lt;br&gt;  &quot;api.target.com&quot; extension:json&lt;br&gt;  &quot;target.com&quot; &quot;BEGIN PRIVATE KEY&quot;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1515" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="gh_2" value="&lt;b&gt;GitHub UI patterns&lt;/b&gt;&lt;br&gt;Beyond code · search Issues, PRs, Wiki, Discussions&lt;br&gt;&quot;target.com&quot; path:**/Dockerfile&lt;br&gt;filename:credentials.yml&lt;br&gt;filename:config.json target&lt;br&gt;Language filters: language:python target.com" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="1690" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="gh_3" value="&lt;b&gt;Forks + deleted repos&lt;/b&gt;&lt;br&gt;Forks often retain commits from deleted repos&lt;br&gt;github.com/$user?tab=repositories&amp;type=fork&lt;br&gt;Waybackmachine on GitHub URLs (find deleted)&lt;br&gt;GHTorrent / GH Archive for historical search" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1690" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="alt_band" value="&lt;b&gt;NON-GITHUB CODE SEARCH · DOCS · LEAK SITES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#ECFCCB;strokeColor=#65A30D;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="1875" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="alt_0" value="&lt;b&gt;GitLab + Bitbucket + SourceGraph&lt;/b&gt;&lt;br&gt;gitlab.com/search?search=target.com&lt;br&gt;bitbucket.org/repo/PROJECT search&lt;br&gt;sourcegraph.com (cross-platform code search)&lt;br&gt;grep.app (super fast pattern grep)&lt;br&gt;Often miss in GitHub-only recon" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#ECFCCB;strokeColor=#65A30D;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="1935" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="alt_1" value="&lt;b&gt;Document &amp; file dorking&lt;/b&gt;&lt;br&gt;site:target.com filetype:pdf confidential&lt;br&gt;site:target.com filetype:xls (spreadsheets)&lt;br&gt;intitle:&quot;index of&quot; site:target.com&lt;br&gt;filetype:log site:target.com&lt;br&gt;Metadata: ExifTool on PDFs (author, paths)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#ECFCCB;strokeColor=#65A30D;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1935" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="alt_2" value="&lt;b&gt;Pastebin &amp; leak sites&lt;/b&gt;&lt;br&gt;psbdmp.ws · pastebin.com/search&lt;br&gt;paste.ee · ghostbin.co · rentry.co&lt;br&gt;IntelX (intelx.io) · leak DB search&lt;br&gt;LeakIX: leakix.net (API-based)&lt;br&gt;HaveIBeenPwned API: breach checking" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#ECFCCB;strokeColor=#65A30D;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="2110" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="alt_3" value="&lt;b&gt;Specialized recon search&lt;/b&gt;&lt;br&gt;urlscan.io: domain:target.com&lt;br&gt;hunter.io: emails for org&lt;br&gt;dnsdumpster.com: DNS map&lt;br&gt;binaryedge.io · netlas.io&lt;br&gt;Threatcrowd · ThreatMiner" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#ECFCCB;strokeColor=#65A30D;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1700" y="2110" width="1400" height="160" as="geometry" />
        </mxCell>
        <mxCell id="v_band" value="&lt;b&gt;VALIDATORS · compliance + safety&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="2295" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v_0" value="&lt;b&gt;V1: Scope check&lt;/b&gt;&lt;br&gt;Dork results filtered against scope_in/out&lt;br&gt;Don&apos;t probe out-of-scope hits" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="2355" width="1020" height="115" as="geometry" />
        </mxCell>
        <mxCell id="v_1" value="&lt;b&gt;V2: Rate awareness&lt;/b&gt;&lt;br&gt;Google/Bing scrape → CAPTCHA risk&lt;br&gt;Use APIs (paid SerpAPI etc.) or manual" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1210" y="2355" width="1020" height="115" as="geometry" />
        </mxCell>
        <mxCell id="v_2" value="&lt;b&gt;V3: API key tracking&lt;/b&gt;&lt;br&gt;Shodan/Censys/FOFA quotas&lt;br&gt;Log every query · track usage" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2290" y="2355" width="1020" height="115" as="geometry" />
        </mxCell>
        <mxCell id="v_3" value="&lt;b&gt;V4: No bulk paste-scraping&lt;/b&gt;&lt;br&gt;Pastebin: targeted only&lt;br&gt;No mass enumeration of personal data" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="2485" width="1020" height="115" as="geometry" />
        </mxCell>
        <mxCell id="v_4" value="&lt;b&gt;V5: AI redaction&lt;/b&gt;&lt;br&gt;Leaked PII/secrets sanitized before AI prompt&lt;br&gt;Only hashes/refs to sensitive data" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1210" y="2485" width="1020" height="115" as="geometry" />
        </mxCell>
        <mxCell id="v_5" value="&lt;b&gt;V6: Evidence attribution&lt;/b&gt;&lt;br&gt;Each dork hit → source query + URL + snapshot&lt;br&gt;Reproducible for triager review" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2290" y="2485" width="1020" height="115" as="geometry" />
        </mxCell>
        <mxCell id="ai_band" value="&lt;b&gt;AI INTEGRATION · OUTPUTS · ANTI-PATTERNS&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="2625" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ai_role" value="&lt;b&gt;AI Role in Dorking&lt;/b&gt;&lt;br&gt;AI generates target-specific dork patterns from biz model + tech stack:&lt;br&gt;  e-commerce → /admin /merchant /api/v*/orders /payment&lt;br&gt;  fintech → /admin /audit /transactions filetype:log&lt;br&gt;AI parses dork results → identify high-value matches&lt;br&gt;AI proposes follow-up dorks (variant hunting)&lt;br&gt;All AI-suggested queries → proposal queue (Page 21)&lt;br&gt;No direct dork execution by AI · always policy-gated" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="2685" width="1050" height="200" as="geometry" />
        </mxCell>
        <mxCell id="outputs" value="&lt;b&gt;Output Artifacts&lt;/b&gt;&lt;br&gt;dork_results.jsonl · per-platform query + matches&lt;br&gt;shodan_pivots.json · favicon-hash + cert pivots&lt;br&gt;gh_dork_findings.json · code search results&lt;br&gt;search_engine_results.json · Google/Bing/DDG hits&lt;br&gt;document_leaks.json · PDF/XLS/log file URLs&lt;br&gt;paste_findings.json · pastebin/leak hits (sanitized)&lt;br&gt;All feed Stage 1/2/4/5 evidence pipeline" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1200" y="2685" width="1020" height="200" as="geometry" />
        </mxCell>
        <mxCell id="anti" value="&lt;b&gt;Anti-Patterns (forbidden)&lt;/b&gt;&lt;br&gt;❌ Bulk personal data scraping (PII protection)&lt;br&gt;❌ Automated Google scraping (ToS violation, CAPTCHA)&lt;br&gt;❌ Out-of-scope dorking (probe only target&apos;s scope)&lt;br&gt;❌ Sharing leaked secrets in AI prompts (redact first)&lt;br&gt;❌ Persistent paste-site monitoring (use targeted queries)&lt;br&gt;❌ Republishing leaks (only reference, never republish)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2240" y="2685" width="1020" height="200" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
