        <mxCell id="g_1" value="&lt;b&gt;Alert gate&lt;/b&gt;&lt;br&gt;Critical alerts route to on-call · medium to dashboard" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
