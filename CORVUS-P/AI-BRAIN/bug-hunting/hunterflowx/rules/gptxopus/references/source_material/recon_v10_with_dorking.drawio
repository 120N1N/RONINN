        <mxCell id="mod" value="&lt;b&gt;Tools / Modules (concrete CLI)&lt;/b&gt;&lt;br&gt;bbot -t root_domains.txt -p subdomain-enum cloud-enum \&lt;br&gt;  -om json,csv -o ./bbot_out -y&lt;br&gt;&lt;br&gt;jq 'select(.type==&quot;DNS_NAME&quot;)|.data' bbot_out/output.json &gt; resolved.txt&lt;br&gt;jq 'select(.type==&quot;STORAGE_BUCKET&quot;)' &gt; buckets.json&lt;br&gt;&lt;br&gt;httpx -l resolved.txt -silent -json -tech-detect -title \&lt;br&gt;  -sc -cl -cdn -tls-probe \&lt;br&gt;  -ports 80,443,8080,8443,3000,5000 -o live.json&lt;br&gt;&lt;br&gt;nuclei -l resolved.txt -t takeovers/ -severity high,critical -j" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;" vertex="1" parent="1">
