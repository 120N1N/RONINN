        <mxCell id="pf_e_5" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=1.5;strokeColor=#2563EB;fontSize=10;fontColor=#475569;" edge="1" parent="1" source="pf_5" target="pf_6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="v_band" value="&lt;b&gt;VALIDATORS (every check is validated)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="950" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="v_0" value="&lt;b&gt;V1: Scope match&lt;/b&gt;&lt;br&gt;Target host must match scope_in regex AND not match scope_out" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="1020" width="1020" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v_1" value="&lt;b&gt;V2: Mode legality&lt;/b&gt;&lt;br&gt;Active scan blocked in passive mode · auth scan needs creds" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1020" width="1020" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v_2" value="&lt;b&gt;V3: Rate within budget&lt;/b&gt;&lt;br&gt;Per-host req/sec must be &lt;= configured budget" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2290" y="1020" width="1020" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v_3" value="&lt;b&gt;V4: Not forbidden&lt;/b&gt;&lt;br&gt;No DoS · no social engineering · no destructive tests" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="1170" width="1020" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v_4" value="&lt;b&gt;V5: Approval present&lt;/b&gt;&lt;br&gt;High-risk classes require human approval token" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1170" width="1020" height="130" as="geometry" />
        </mxCell>
        <mxCell id="v_5" value="&lt;b&gt;V6: Audit trail&lt;/b&gt;&lt;br&gt;Decision logged with timestamp, actor, reason, evidence" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2290" y="1170" width="1020" height="130" as="geometry" />
        </mxCell>
        <mxCell id="g_band" value="&lt;b&gt;GATE + OPERATIONAL NOTES&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="1340" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="g_0" value="&lt;b&gt;Hard fail behavior&lt;/b&gt;&lt;br&gt;Any V1-V4 fail → action blocked · no retry · alert raised" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="1410" width="1400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="g_1" value="&lt;b&gt;Soft gate behavior&lt;/b&gt;&lt;br&gt;V5 needs_approval → queue for human · timeout = deny" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1410" width="1400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="g_2" value="&lt;b&gt;Kill switch&lt;/b&gt;&lt;br&gt;Redis kill_switch:1 stops ALL workers immediately (emergency)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="200" y="1575" width="1400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="g_3" value="&lt;b&gt;Snapshot rule&lt;/b&gt;&lt;br&gt;policy_snapshot is immutable per run · changes spawn new run" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1700" y="1575" width="1400" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ic_band" value="&lt;b&gt;I/O CONTRACT&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="1750" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="ic_h1" value="&lt;b&gt;Contract area&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=11;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="1820" width="620" height="42" as="geometry" />
        </mxCell>
        <mxCell id="ic_h2" value="&lt;b&gt;Requirement&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=11;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="740" y="1820" width="1450" height="42" as="geometry" />
        </mxCell>
        <mxCell id="ic_h3" value="&lt;b&gt;Failure handling&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=11;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2190" y="1820" width="1090" height="42" as="geometry" />
        </mxCell>
        <mxCell id="ic_a0" value="policy_snapshot.json" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="1862" width="620" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ic_b0" value="Includes scope, mode, rate, forbidden, approvals, timestamp, actor" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="740" y="1862" width="1450" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ic_c0" value="Missing → run blocked" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2190" y="1862" width="1090" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ic_a1" value="action_decision.json" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="1934" width="620" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ic_b1" value="Per-action: allow/deny/needs_approval + reason + validator IDs" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="740" y="1934" width="1450" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ic_c1" value="No decision → block" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2190" y="1934" width="1090" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ic_a2" value="audit.log" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="2006" width="620" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ic_b2" value="Append-only · structured JSON · timestamp + correlation_id" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="740" y="2006" width="1450" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ic_c2" value="Write fail → halt" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2190" y="2006" width="1090" height="72" as="geometry" />
        </mxCell>
        <mxCell id="cap_pg_band" value="&lt;b&gt;CAPTCHA / BOT CHALLENGE POLICY EXTENSION&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=8;fontSize=13;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="100" y="2150" width="3200" height="40" as="geometry" />
        </mxCell>
        <mxCell id="cap_pg_0" value="&lt;b&gt;Boundary rule&lt;/b&gt;&lt;br&gt;CAPTCHA, Turnstile, bot wall, fraud wall, or access challenge is a boundary. Default action: pause automation for that host/path; do not bypass; do not retry-loop." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="2220" width="760" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cap_pg_1" value="&lt;b&gt;Decision output&lt;/b&gt;&lt;br&gt;action_decision = deny_or_manual_required&lt;br&gt;reason = captcha_detected&lt;br&gt;asset.tag = captcha_protected&lt;br&gt;worker.pause(host_or_path)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="930" y="2220" width="760" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cap_pg_2" value="&lt;b&gt;Allowed continuation&lt;/b&gt;&lt;br&gt;Only manual validation with owned test accounts, program-allowed authenticated testing, recorded evidence, and human approval. Automation may continue on unrelated allowed assets." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1730" y="2220" width="760" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cap_pg_3" value="&lt;b&gt;Blocked behaviors&lt;/b&gt;&lt;br&gt;No solver services · no fingerprint spoofing · no proxy rotation to evade · no mass signup · no anti-bot bypass · no repeated challenge probing." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="2530" y="2220" width="760" height="135" as="geometry" />
        </mxCell>
        <mxCell id="cap_pg_4" value="&lt;b&gt;I/O addendum&lt;/b&gt;&lt;br&gt;captcha_events.jsonl = {url, host, provider_guess, status_code, screenshot_ref, action, next_step}&lt;br&gt;manual_required_queue.jsonl = test card linked to evidence_ref" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="130" y="2375" width="1560" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cap_pg_5" value="&lt;b&gt;Validator V7: Challenge boundary&lt;/b&gt;&lt;br&gt;If challenge_detected=true then active discovery/fuzzing/login automation is blocked for the affected host/path until manually cleared." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1730" y="2375" width="1560" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="03 Asset Graph Model" id="03-graph">
