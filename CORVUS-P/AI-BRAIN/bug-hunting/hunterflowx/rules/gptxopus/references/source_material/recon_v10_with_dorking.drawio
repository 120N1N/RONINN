        <mxCell id="m0" value="&lt;b&gt;Cross-Stage Correlator&lt;/b&gt;&lt;br&gt;Find connections across discovery, auth, behavior, monitoring, and manual evidence." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
