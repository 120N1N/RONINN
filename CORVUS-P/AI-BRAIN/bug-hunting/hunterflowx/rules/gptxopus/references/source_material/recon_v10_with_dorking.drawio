        <mxCell id="v_4" value="&lt;b&gt;V5: CVE relevance&lt;/b&gt;&lt;br&gt;Only CVEs matching detected stack alerted" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;" vertex="1" parent="1">
