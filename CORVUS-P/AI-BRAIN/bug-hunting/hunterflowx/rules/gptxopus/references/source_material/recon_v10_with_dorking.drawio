        <mxCell id="why" value="&lt;b&gt;Why v9 differs from v8&lt;/b&gt;&lt;br&gt;v9 keeps the deep tool coverage, CAPTCHA guard, compliance layer, and evidence-linked validation from v8, then adds a governed AI creativity model: AI can think beyond the linear checklist, propose novel branches, create semantic discovery ideas, challenge coverage gaps, and reason over negative results. Every AI-generated action still becomes a policy-gated proposal, tool-run request, graph query, or manual test card." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="1660" width="3160" height="200" as="geometry" />
        </mxCell>
        <mxCell id="safety" value="&lt;b&gt;Safety note&lt;/b&gt;&lt;br&gt;This workflow is for AUTHORIZED bug bounty / security testing only. Use owned accounts and data. Avoid destructive tests, third-party data access, high-volume brute force, credential attacks, CAPTCHA bypass, anti-bot evasion, solver services, or anything forbidden by the program rules." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1">
