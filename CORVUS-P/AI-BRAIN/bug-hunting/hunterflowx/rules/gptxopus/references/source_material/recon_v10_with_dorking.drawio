        <mxCell id="g_0" value="&lt;b&gt;Rate gate&lt;/b&gt;&lt;br&gt;Monitor cron jobs respect overall rate budget" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
