        <mxCell id="o0" value="&lt;b&gt;coverage_gap.jsonl&lt;/b&gt;&lt;br&gt;what was not covered · why it matters · suggested safe next step" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F5F3FF;strokeColor=#A78BFA;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
