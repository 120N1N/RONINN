        <mxCell id="mod" value="&lt;b&gt;Tools / Modules (concrete CLI)&lt;/b&gt;&lt;br&gt;nuclei -l live.txt -severity medium,high,critical \&lt;br&gt;  -tags cve,exposure,misconfig,token,auth -rl $POLICY_RL -c $POLICY_C -jsonl -o nuclei.jsonl&lt;br&gt;&lt;br&gt;# Tech → CVE: NVD API + CISA KEV catalog match&lt;br&gt;wpscan --url $URL --enumerate vp,vt --format json -o wp.json   # CMS-specific, passive/safe enum only&lt;br&gt;&lt;br&gt;dalfox file gf_xss.txt --format json -o xss.json&lt;br&gt;sqlmap -m gf_sqli.txt --batch --risk=1 --level=1 --safe-url=$SAFE_URL&lt;br&gt;cat gf_ssrf.txt | qsreplace &quot;https://$INTERACTSH&quot; | httpx -follow-redirects&lt;br&gt;&lt;br&gt;# Upload validation: metadata/canary file only · no active content execution&lt;br&gt;# IDOR: replay role-A request as role-B using owned tester objects · privilege_matrix lookup" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fontSize=10;fontColor=#0B1220;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1">
