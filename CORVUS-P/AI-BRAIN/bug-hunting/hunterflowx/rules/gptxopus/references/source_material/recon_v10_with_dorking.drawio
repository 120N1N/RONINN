        <mxCell id="n1" value="&lt;b&gt;Katana found little&lt;/b&gt;&lt;br&gt;Maybe routes are in JS chunks, sourcemaps, mobile app, API docs, role-gated UI, or behind post-login workflows." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#FFFBEB;strokeColor=#F59E0B;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="1220" y="980" width="1010" height="165" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Nuclei found nothing&lt;/b&gt;&lt;br&gt;Good signal, not proof of no bugs. Shift toward auth logic, workflow abuse, role/tenant diff, and API object access." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="2300" y="980" width="1010" height="165" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;API discovery is thin&lt;/b&gt;&lt;br&gt;Check OpenAPI paths, GraphQL introspection status, kiterunner patterns, mobile endpoints, historical URLs, and JS API clients." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#ECFDF5;strokeColor=#34D399;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="140" y="1200" width="1010" height="165" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="&lt;b&gt;Auth recon clean&lt;/b&gt;&lt;br&gt;Test less obvious states: recovery, invite acceptance, pending user, deleted object, disabled account, plan downgrade, cross-tenant export." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=14;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=12;fontColor=#0F172A;" vertex="1" parent="1">
