          <mxGeometry x="40" y="25" width="3320" height="44" as="geometry" />
        </mxCell>
        <mxCell id="h_sub" value="Every AI idea becomes an auditable proposal before tool execution or manual validation" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=0;fontColor=#475569;" vertex="1" parent="1">
