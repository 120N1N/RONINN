tColor=#134e4a;" vertex="1" parent="1"><mxGeometry x="960" y="140" width="300" height="230" as="geometry" /></mxCell><mxCell id="indexer" value="Dashboard Indexer&lt;br&gt;scan engagements/*/*/data/graph_state.json&lt;br&gt;sort by modified time&lt;br&gt;serve selected graph" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2563eb;fillColor=#dbeafe;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1380" y="160" width="340" height="170" as="geometry" /></mxCell><mxCell id="commands" value="Recommended Command Flow&lt;br&gt;bbf init &lt;program&gt; &lt;target&gt;&lt;br&gt;cd engagements/&lt;program&gt;/&lt;target&gt;&lt;br&gt;bbf import-reconfw &lt;workspace&gt;&lt;br&gt;bbf pentest-card &lt;bug-class|a01|api01&gt;&lt;br&gt;bbf angle-plan full&lt;br&gt;bbf angle-exec --transport burp|caido|browser&lt;br&gt;bbf evidence-score&lt;br&gt;bbf judge&lt;br&gt;bbf source-verify --source-root &lt;path&gt;&lt;br&gt;bbf risk-prioritize --limit 25&lt;br&gt;bbf owasp-plan web|api|both&lt;br&gt;bbf build&lt;br&gt;bbf coverage" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2563eb;fillColor=#dbeafe;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="130" y="500" width="455" height="435" as="geometry" /></mxCell><mxCell id="separate" value="Engagement Separation&lt;br&gt;No cross-target evidence mixing&lt;br&gt;No token leakage between folders&lt;br&gt;No old engagement data in new scope&lt;br&gt;Archive when done" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#b45309;fillColor=#fef3c7;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="700" y="570" width="370" height="190" as="geometry" /></mxCell><mxCell id="scale" value="Scale Pattern&lt;br&gt;Run many engagements.&lt;br&gt;Keep one dashboard.&lt;br&gt;Use separate event ledgers.&lt;br&gt;Compare metrics, not chats." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;strokeColor=#ca8a04;fillColor=#fef9c3;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="1210" y="570" width="370" height="190" as="geometry" /></mxCell><mxCell id="e1" value="isolated state" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="roots" target="owns"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="graph state" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="owns" target="indexer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="selector" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="indexer" target="port"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="discipline" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="commands" target="separate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="safe scale" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="separate" target="scale"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="single view" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#64748b;fontColor=#334155;dashed=1;" edge="1" parent="1" source="scale" target="port"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="08-source-to-multi-angle-chain" name="08 Source To Multi-Angle Chain"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n2" value="Source-To-Flow, Multi-Angle Testing, And Chaining" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="36" as="geometry" /></mxCell><mxCell id="n3" value="Aturan baru: source dibaca satu per satu, dihubungkan ke flow target, lalu setiap endpoint diuji dari banyak angle dan dipakai untuk chaining." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1120" height="42" as="geometry" /></mxCell><mxCell id="queue" value="Source Queue&lt;br&gt;source-file-queue.md&lt;br&gt;JS / PHP / Python&lt;br&gt;configs / templates&lt;br&gt;controllers / models&lt;br&gt;routes / API specs" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;strokeColor=#0f766e;fillColor=#ccfbf1;fontColor=#134e4a;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="280" height="210" as="geometry" /></mxCell><mxCell id="onefile" value="One File Gate&lt;br&gt;read one file fully&lt;br&gt;write source-reviews/&lt;file-id&gt;.md&lt;br&gt;RESTATE-OK&lt;br&gt;no next file before artifact" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#b45309;fillColor=#fef3c7;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="290" height="210" as="geometry" /></mxCell><mxCell id="flow" value="Flow Extraction&lt;br&gt;entrypoints&lt;br&gt;routes&lt;br&gt;handlers&lt;br&gt;middleware&lt;br&gt;services&lt;br&gt;models/queries&lt;br&gt;external calls&lt;br&gt;frontend API calls" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2563eb;fillColor=#dbeafe;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="810" y="150" width="290" height="230" as="geometry" /></mxCell><mxCell id="flowevents" value="Flow Link Events&lt;br&gt;source_file_read&lt;br&gt;source_flow_linked&lt;br&gt;attack_surface_mapped&lt;br&gt;endpoint_angle_planned" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#7c3aed;fillColor=#ede9fe;fontColor=#4c1d95;" vertex="1" parent="1"><mxGeometry x="1190" y="170" width="250" height="190" as="geometry" /></mxCell><mxCell id="surface" value="Source Completeness + Risk&lt;br&gt;bbf source-verify&lt;br&gt;inventory important files&lt;br&gt;review artifact check&lt;br&gt;&lt;br&gt;bbf risk-prioritize&lt;br&gt;rank P0/P1 endpoints&lt;br&gt;endpoint_prioritized" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0891b2;fillColor=#cffafe;fontColor=#164e63;" vertex="1" parent="1"><mxGeometry x="1530" y="125" width="280" height="280" as="geometry" /></mxCell><mxCell id="matrix" value="Endpoint Multi-Angle Matrix&lt;br&gt;core 14 angles:&lt;br&gt;authn_session&lt;br&gt;authz_role&lt;br&gt;object_tenant_boundary&lt;br&gt;input_validation&lt;br&gt;state_transition&lt;br&gt;business_logic&lt;br&gt;data_exposure&lt;br&gt;side_effect_write&lt;br&gt;rate_limit_or_race&lt;br&gt;cache_cors_redirect&lt;br&gt;file_or_url_handling&lt;br&gt;error_oracle&lt;br&gt;source_runtime_diff&lt;br&gt;chain_potential&lt;br&gt;&lt;br&gt;deep adds 8 more:&lt;br&gt;method/content-type&lt;br&gt;field-level auth&lt;br&gt;shadow API&lt;br&gt;async job/export&lt;br&gt;idempotency/replay&lt;br&gt;client trust&lt;br&gt;webhook/callback&lt;br&gt;search/filter/pagination" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#94a3b8;fillColor=#ffffff;fontColor=#334155;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="500" width="390" height="420" as="geometry" /></mxCell><mxCell id="planned" value="Plan Angle&lt;br&gt;bbf angle-plan full&lt;br&gt;endpoint_angle_planned&lt;br&gt;status = queued&lt;br&gt;planned_angles must rise&lt;br&gt;not counted as tested&lt;br&gt;keeps untested work visible" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#7c3aed;fillColor=#ede9fe;fontColor=#4c1d95;" vertex="1" parent="1"><mxGeometry x="520" y="575" width="300" height="215" as="geometry" /></mxCell><mxCell id="tested" value="Test Angle&lt;br&gt;endpoint_angle_tested&lt;br&g