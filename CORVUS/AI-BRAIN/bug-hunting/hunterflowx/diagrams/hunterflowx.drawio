<mxfile host="app.diagrams.net" modified="2026-05-18T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="00-control-plane-overview" name="00 Control Plane Overview"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n2" value="Hunterflowx - Control Plane" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="36" as="geometry" /></mxCell><mxCell id="n3" value="Prinsip inti: AI chat bukan truth. Event, evidence, graph, ledger, dan verdict gate adalah sumber kebenaran." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1120" height="42" as="geometry" /></mxCell><mxCell id="input" value="Input Layer&lt;br&gt;AI operator&lt;br&gt;Human operator&lt;br&gt;Importer / bridge&lt;br&gt;Browser / Burp evidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#64748b;fillColor=#f1f5f9;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="210" height="120" as="geometry" /></mxCell><mxCell id="scope" value="Scope &amp; Safety Gate&lt;br&gt;scope.md&lt;br&gt;notes/rules.md&lt;br&gt;rate limit&lt;br&gt;allowed accounts&lt;br&gt;forbidden actions" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#b45309;fillColor=#fef3c7;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="230" height="140" as="geometry" /></mxCell><mxCell id="norm" value="Action Normalizer&lt;br&gt;bbf event&lt;br&gt;bbf import-reconfw&lt;br&gt;bbf pentest-card&lt;br&gt;bbf angle-plan&lt;br&gt;bbf angle-exec&lt;br&gt;bbf evidence-score&lt;br&gt;bbf judge&lt;br&gt;bbf source-verify&lt;br&gt;bbf risk-prioritize&lt;br&gt;bbf domain-plan&lt;br&gt;bbf domain-verify&lt;br&gt;bbf owasp-plan&lt;br&gt;manual notes -&gt; event" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2563eb;fillColor=#dbeafe;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="245" height="250" as="geometry" /></mxCell><mxCell id="events" value="Append-only Ledger&lt;br&gt;data/events.jsonl&lt;br&gt;Every meaningful action becomes durable state" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;strokeColor=#0f766e;fillColor=#ccfbf1;fontColor=#134e4a;" vertex="1" parent="1"><mxGeometry x="910" y="150" width="230" height="120" as="geometry" /></mxCell><mxCell id="builder" value="Graph Builder&lt;br&gt;scripts/build_graph.py&lt;br&gt;nodes, edges, metrics&lt;br&gt;planned vs tested" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2563eb;fillColor=#dbeafe;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1200" y="150" width="220" height="120" as="geometry" /></mxCell><mxCell id="dash" value="Live Dashboard&lt;br&gt;http://127.0.0.1:5173&lt;br&gt;multi-engagement selector&lt;br&gt;coverage + gaps" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0891b2;fillColor=#cffafe;fontColor=#164e63;" vertex="1" parent="1"><mxGeometry x="1490" y="150" width="220" height="120" as="geometry" /></mxCell><mxCell id="sources" value="Source Layers&lt;br&gt;hunterweb/recon-framework&lt;br&gt;GPTxOPUS A01-A10&lt;br&gt;source-grounded test cards&lt;br&gt;browser/Caido/Burp evidence loop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#94a3b8;fillColor=#ffffff;fontColor=#334155;fontSize=11;" vertex="1" parent="1"><mxGeometry x="80" y="360" width="280" height="240" as="geometry" /></mxCell><mxCell id="bridge_rule" value="Bridge Rule&lt;br&gt;External output is input only.&lt;br&gt;It cannot become confirmed until it passes final event -&gt; evidence -&gt; verdict." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;strokeColor=#ca8a04;fillColor=#fef9c3;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="420" y="385" width="300" height="160" as="geometry" /></mxCell><mxCell id="state" value="Workflow State&lt;br&gt;coverage-matrix.md&lt;br&gt;test-ledger.md&lt;br&gt;notes/loop/queue.md&lt;br&gt;notes/loop/log.md&lt;br&gt;priority-testing-plan.md&lt;br&gt;domain-depth/" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;strokeColor=#0f766e;fillColor=#ccfbf1;fontColor=#134e4a;" vertex="1" parent="1"><mxGeometry x="790" y="360" width="270" height="220" as="geometry" /></mxCell><mxCell id="evidence" value="Evidence Store&lt;br&gt;evidence/burp&lt;br&gt;evidence/caido&lt;br&gt;evidence/responses&lt;br&gt;evidence/screenshots&lt;br&gt;evidence/logs&lt;br&gt;redacted secrets only" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#15803d;fillColor=#dcfce7;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1130" y="360" width="270" height="240" as="geometry" /></mxCell><mxCell id="verdict" value="Verdict Authority&lt;br&gt;confirmed&lt;br&gt;finding_candidate&lt;br&gt;tested_secure&lt;br&gt;inconclusive&lt;br&gt;blocked/out_of_scope/by_design" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#b91c1c;fillColor=#fee2e2;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1470" y="360" width="260" height="220" as="geometry" /></mxCell><mxCell id="contract" value="Anti-False-Positive Contract&lt;br&gt;No source-only confirmation&lt;br&gt;No scanner-only report&lt;br&gt;No HTTP 200 = impact&lt;br&gt;No dead end disappears&lt;br&gt;No report without evidence" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#dc2626;fillColor=#fee2e2;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="80" y="700" width="390" height="190" as="geometry" /></mxCell><mxCell id="handoff" value="End-of-Session Handoff&lt;br&gt;Events written&lt;br&gt;Endpoints added&lt;br&gt;Tests performed&lt;br&gt;Evidence saved&lt;br&gt;Verdicts changed&lt;br&gt;Active loops&lt;br&gt;Pivots created&lt;br&gt;Open gaps&lt;br&gt;Next safest action" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;strokeColor=#ca8a04;fillColor=#fef9c3;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="540" y="700" width="390" height="190" as="geometry" /></mxCell><mxCell id="loop" value="Recursive Hunting Loop&lt;br&gt;recon -&gt; analyze -&gt; expand -&gt; retest -&gt; repeat&lt;br&gt;Endpoint, JS, fingerprint, param, and evidence can reopen loops." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2563eb;fillColor=#dbeafe;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1000" y="700" width="390" height="190" as="geometry" /></mxCell><mxCell id="operator" value="Operator View&lt;br&gt;Dashboard shows what is mapped, planned, tested, source-incomplete, blocked, missing evidence, and still looping." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0891b2;fillColor=#cffafe;fontColor=#164e63;" vertex="1" parent="1"><mxGeometry x="1460" y="700" width="280" height="190" as="geometry" /></mxCell><mxCell id="e1" value="authorize first" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="input" target="scope"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="safe action" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="scope" target="norm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="JSONL event" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="norm" target="events"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="rebuild" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="events" target="builder"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="graph_state.json" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="builder" target="dash"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="methodology + raw output" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="sources" target="bridge_rule"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="converted to events" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="bridge_rule" target="norm"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="human-readable ledger" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="events" target="state"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="test must link proof" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="state" target="evidence"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="evidence review" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="evidence" target="verdict"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="verdict_set" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#16a34a;fontColor=#166534;" edge="1" parent="1" source="verdict" target="events"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="quality bar" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="contract" target="handoff"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="next action" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="handoff" target="loop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="visible state" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="loop" target="operator"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="continue safely" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#64748b;fontColor=#334155;dashed=1;" edge="1" parent="1" source="operator" target="input"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="01-engagement-lifecycle" name="01 Engagement Lifecycle"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n2" value="Engagement Lifecycle" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="36" as="geometry" /></mxCell><mxCell id="n3" value="Dari init sampai report: semua tahap harus meninggalkan event, ledger, dan evidence trail." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#4b5563;" vertex="1" parent="1"><mxGeometry x="42" y="62" width="1120" height="42" as="geometry" /></mxCell><mxCell id="s0" value="1. Init Engagement&lt;br&gt;bbf init &lt;program&gt; &lt;target&gt;&lt;br&gt;creates scoped workspace" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#64748b;fillColor=#f1f5f9;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="190" height="130" as="geometry" /></mxCell><mxCell id="s1" value="2. Load Scope&lt;br&gt;scope.md&lt;br&gt;notes/rules.md&lt;br&gt;rate budget&lt;br&gt;accounts" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#b45309;fillColor=#fef3c7;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="310" y="170" width="190" height="130" as="geometry" /></mxCell><mxCell id="s2" value="3. Map Surface&lt;br&gt;assets&lt;br&gt;endpoints&lt;br&gt;params&lt;br&gt;JS&lt;br&gt;source routes" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2563eb;fillColor=#dbeafe;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="560" y="170" width="190" height="130" as="geometry" /></mxCell><mxCell id="s3" value="4. Plan Tests&lt;br&gt;pentest-card&lt;br&gt;priority plan&lt;br&gt;loop queue&lt;br&gt;coverage matrix" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#7c3aed;fillColor=#ede9fe;fontColor=#4c1d95;" vertex="1" parent="1"><mxGeometry x="810" y="170" width="190" height="130" as="geometry" /></mxCell><mxCell id="s4" value="5. Execute Safely&lt;br&gt;browser/Burp&lt;br&gt;controls&lt;br&gt;payload attempts&lt;br&gt;read-back" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#2563eb;fillColor=#dbeafe;fontColor=#1e3a8a;" vertex="1" parent="1"><mxGeometry x="1060" y="170" width="190" height="130" as="geometry" /></mxCell><mxCell id="s5" value="6. Save Evidence&lt;br&gt;Burp req/resp&lt;br&gt;screenshots&lt;br&gt;responses&lt;br&gt;logs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#15803d;fillColor=#dcfce7;fontColor=#14532d;" vertex="1" parent="1"><mxGeometry x="1310" y="170" width="190" height="130" as="geometry" /></mxCell><mxCell id="s6" value="7. Verdict/Handoff&lt;br&gt;verdict_set&lt;br&gt;report draft&lt;br&gt;next loop&lt;br&gt;open gaps" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#b91c1c;fillColor=#fee2e2;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1560" y="170" width="190" height="130" as="geometry" /></mxCell><mxCell id="pre" value="Required Before Live Testing&lt;br&gt;- scope loaded&lt;br&gt;- out-of-scope known&lt;br&gt;- rate limit known&lt;br&gt;- owned test accounts known&lt;br&gt;- forbidden actions known" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#b45309;fillColor=#fef3c7;fontColor=#78350f;" vertex="1" parent="1"><mxGeometry x="90" y="420" width="360" height="190" as="geometry" /></mxCell><mxCell id="types" value="Event Types By Stage&lt;br&gt;scope_loaded&lt;br&gt;asset_added&lt;br&gt;endpoint_discovered&lt;br&gt;param_discovered&lt;br&gt;test_planned&lt;br&gt;test_started&lt;br&gt;payload_attempted&lt;br&gt;control_request_sent&lt;br&gt;evidence_added&lt;br&gt;verdict_set" style="shape=cylinder3d;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;strokeColor=#0f766e;fillColor=#ccfbf1;fontColor=#134e4a;" vertex="1" parent="1"><mxGeometry x="520" y="390" width="360" height="250" as="geometry" /></mxCell><mxCell id="coverage" value="Coverage Review&lt;br&gt;check_coverage.py answers:&lt;br&gt;- total endpoints&lt;br&gt;- tested endpoints&lt;br&gt;- planned tests&lt;br&gt;- evidence missing&lt;br&gt;- open gaps&lt;br&gt;- active loops&lt;br&gt;- dead ends no decision" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0891b2;fillColor=#cffafe;fontColor=#164e63;" vertex="1" parent="1"><mxGeometry x="950" y="390" width="360" height="250" as="geometry" /></mxCell><mxCell id="stop" value="Stop Condition&lt;br&gt;If scope/session/evidence is missing:&lt;br&gt;write blocked or inconclusive.&lt;br&gt;Do not continue as if testing was complete." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#dc2626;fillColor=#fee2e2;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1380" y="420" width="330" height="190" as="geometry" /></mxCell><mxCell id="partition" value="Clean Workspace Partition&lt;br&gt;engagements/&lt;program&gt;/&lt;target&gt;/&lt;br&gt;data/&lt;br&gt;evidence/&lt;br&gt;findings/&lt;br&gt;reports/&lt;br&gt;notes/&lt;br&gt;leads/test-cards/&lt;br&gt;.private/" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#94a3b8;fillColor=#ffffff;fontColor=#334155;fontSize=11;" vertex="1" parent="1"><mxGeometry x="90" y="760" width="390" height="190" as="geometry" /></mxCell><mxCell id="folder_memory" value="Rule&lt;br&gt;The folder is the memory.&lt;br&gt;Chat only explains the state; it does not replace the state." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;strokeColor=#ca8a04;fillColor=#fef9c3;fontColor=#713f12;" vertex="1" parent="1"><mxGeometry x="560" y="780" width="390" height="150" as="geometry" /></mxCell><mxCell id="ready" value="Report Readiness&lt;br&gt;A report starts only after:&lt;br&gt;1. impact proven&lt;br&gt;2. evidence saved&lt;br&gt;3. verdict set&lt;br&gt;4. duplicate/known behavior checked&lt;br&gt;5. steps reproduce" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#b91c1c;fillColor=#fee2e2;fontColor=#7f1d1d;" vertex="1" parent="1"><mxGeometry x="1030" y="760" width="390" height="190" as="geometry" /></mxCell><mxCell id="e1" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="s0" target="s1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=block;html=1;rounded=0;strokeWidth=2;strokeColor=#475569;fontColor=#334155;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value=""